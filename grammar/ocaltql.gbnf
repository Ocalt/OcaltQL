# OcaltQL grammar for constrained generation (GBNF, as read by llama.cpp and
# compatible engines). Generated from the OcaltQL runtime's verb table;
# do not edit by hand. The readable version with explanations is ocaltql.ebnf.
# Keywords are rules named k-WORD (and g-NAME for !globals); each accepts
# any letter case. Modifiers may come in any order, as in the language.

root ::= ws script ws

script ::= sequence
sequence ::= or-chain (ws1 k-AFTER ws1 or-chain (ws1 k-AFTER ws1 or-chain)*)?
or-chain ::= and-group (ws1 k-OR ws1 and-group (ws1 k-OR ws1 and-group)*)?
and-group ::= statement (ws1 k-AND ws1 statement (ws1 k-AND ws1 statement)*)?
