# OcaltQL GBNF — core syntax plus a deliberately permissive feature-command surface.
# Keywords are encoded case-insensitively; uppercase is a readable convention, not a requirement.
# See README.md: feature-command arguments are not fully signature-validated.

root ::= gap chain gap

# Chain: the first statement has no prefix; subsequent statements require a chain keyword.
chain ::= statement period? (sp chain_link sp statement period?)*
chain_link ::= k_after | k_and | k_or
period ::= "."

statement ::= if_statement
            | while_statement
            | loop_statement
            | foreach_statement
            | switch_statement
            | operation_definition
            | class_definition
            | spawn_statement
            | persistent_storage_statement
            | core_statement
            | extension_statement

# IF owns its OR IF and OR OPEN branches. OR in a comparison phrase is parsed inside condition.
if_statement ::= k_if sp condition sp block (sp k_or sp k_if sp condition sp block)* (sp k_or sp block)?
while_statement ::= k_while sp condition sp block
loop_statement ::= k_loop sp value sp k_to sp value (sp k_step sp number)? sp k_set sp variable sp block
foreach_statement ::= k_foreach sp access_path sp k_set sp variable (sp k_as sp variable)? sp block

block ::= k_open sp chain? sp k_close

switch_statement ::= k_switch sp value sp k_open sp switch_body sp k_close
switch_body ::= switch_case (sp switch_case)*
switch_case ::= k_case sp value (sp chain)?
              | k_default (sp chain)?

operation_definition ::= k_new sp k_persistent sp k_operation sp identifier (sp k_with sp operation_parameter (sp k_and sp operation_parameter)*)? sp block
                       | k_new sp k_operation sp identifier (sp k_with sp operation_parameter (sp k_and sp operation_parameter)*)? sp block
operation_parameter ::= variable (sp k_as sp operation_type (sp (k_required | k_default sp value))?)?
operation_type ::= k_string | k_number | k_bool | k_date

class_definition ::= k_new sp k_class sp identifier sp k_with sp class_member (sp k_and sp class_member)* sp block
class_member ::= string_literal sp k_as sp (k_string | k_number | k_bool | k_date | k_method) (sp (k_required | k_default sp value))?
spawn_statement ::= k_spawn sp identifier (sp k_with sp class_argument (sp k_and sp class_argument)*)? result_clause?
class_argument ::= string_literal sp k_as sp value
persistent_storage_statement ::= k_set sp k_persistent sp variable sp k_as sp value
                               | k_consistent sp value result_clause
                               | k_start sp k_persist
                               | k_kill sp k_persist

core_statement ::= emit_statement
                 | string_statement
                 | number_statement
                 | set_statement
                 | unset_statement
                 | variable_copy_statement
                 | calculate_statement
                 | return_statement
                 | run_statement
                 | exit_statement
                 | break_statement
                 | continue_statement
                 | catch_statement
                 | warning_statement
                 | array_object_statement
                 | string_operation
                 | date_time_statement
                 | conversion_statement
                 | network_statement
                 | file_statement
                 | header_statement
                 | wait_sleep_statement

emit_statement ::= k_emit sp value_expression
string_statement ::= k_string sp value_expression result_clause
number_statement ::= k_number sp value result_clause
set_statement ::= k_set sp assignment_target sp k_as sp value
unset_statement ::= k_unset sp k_persistent sp variable
                  | k_unset sp variable
variable_copy_statement ::= k_variable sp reference sp k_set sp variable
assignment_target ::= access_path
access_path ::= reference | of_reference

calculate_statement ::= k_calculate sp (math_expression | date_calculation | date_difference) result_clause?
date_difference ::= reference sp "-" sp reference sp k_as sp (k_days | k_hours | k_years)
return_statement ::= k_return (sp value_expression)?
run_statement ::= k_run sp k_persistent sp identifier (sp k_with sp value (sp k_and sp value)*)? result_clause?
                | k_run sp identifier (sp k_with sp value (sp k_and sp value)*)? result_clause?
exit_statement ::= k_exit (sp value)?
break_statement ::= k_break
continue_statement ::= k_continue
catch_statement ::= k_catch sp k_error result_clause?
warning_statement ::= k_warning sp value

result_clause ::= sp k_set sp variable
                | sp k_set sp k_promise sp variable
                | sp k_set sp k_persistent sp variable
                | sp k_set sp k_consistent sp value

array_object_statement ::= k_new sp k_array result_clause
                         | k_new sp k_multiarray result_clause
                         | k_new sp k_object ("[" object_fields "]")? result_clause
                         | k_append sp value sp k_to sp reference
                         | k_append sp value sp k_as sp value sp k_to sp reference
                         | k_count sp reference result_clause
                         | k_collapse sp reference result_clause
                         | k_flatten sp reference result_clause
                         | k_keys sp reference result_clause
                         | k_values sp reference result_clause
                         | k_remove sp k_key sp value sp k_from sp reference result_clause?
                         | k_search sp k_array sp reference sp k_for sp value result_clause
                         | k_search sp k_object sp reference sp k_for sp value result_clause
                         | k_join (sp k_array)? sp reference (sp k_with sp value)? result_clause
                         | k_slice sp reference sp k_from sp value sp k_to sp value result_clause
                         | k_sort sp reference (sp (k_ascending | k_descending))? (sp k_by sp value)? result_clause?
                         | k_merge sp (k_array | k_object) sp reference sp k_with sp reference result_clause
                         | k_reverse sp k_array sp reference result_clause

object_fields ::= object_field (sp k_and sp object_field)*
object_field ::= string_literal sp k_as sp value

string_operation ::= k_length sp value result_clause
                   | k_string sp k_uppercase sp value result_clause
                   | k_string sp k_lowercase sp value result_clause
                   | k_trim sp k_string sp value result_clause
                   | k_reverse sp k_string sp value result_clause
                   | k_replace sp k_string sp k_all sp value sp k_with sp value sp k_where sp value result_clause?
                   | k_replace sp k_string sp k_once sp value sp k_with sp value sp k_where sp value result_clause?
                   | k_replace sp k_string sp k_from sp value sp k_to sp value sp k_with sp value sp k_where sp value result_clause?
                   | k_search sp k_string sp value sp k_for sp value result_clause
                   | k_select sp k_string sp value sp k_from sp value sp k_to sp value result_clause
                   | k_split sp value sp k_by sp value result_clause

date_time_statement ::= k_new sp k_date (sp k_and sp k_time)? (sp k_from sp value)? result_clause
                      | k_new sp k_time (sp k_from sp value)? result_clause
                      | k_get sp value sp (k_day | k_month) sp (k_fullname | k_shortname) result_clause
                      | k_get sp value sp (k_year | k_month | k_day | k_hour | k_minute | k_second | k_timestamp) result_clause
                      | k_format sp (k_date | k_time | k_date sp k_and sp k_time) sp value sp k_as sp string_literal result_clause

date_calculation ::= reference sp ("+" | "-") sp value sp (k_day | k_days | k_week | k_weeks | k_month | k_months | k_year | k_years | k_minutes | k_hours)
                   | reference sp (k_first | k_last) sp k_day

conversion_statement ::= k_cast sp value sp k_as sp (k_string | k_number | k_bool | k_date | k_json | k_oqlobject) (sp k_from sp value)? result_clause?
                       | k_parse sp value sp k_as sp identifier result_clause
                       | (k_encode | k_decode) sp value sp k_as sp identifier (sp k_from sp identifier)? result_clause?
                       | k_convert sp identifier sp value (sp k_to sp value)? result_clause?

network_statement ::= k_fetch sp value (sp k_method sp value)? (sp (k_header | k_body | k_user sp k_agent | k_ip | k_proxy | k_timeout | k_into) sp value)* (sp k_seconds)? result_clause?
                    | k_curl sp value (sp k_method sp value)? (sp (k_header | k_body | k_user sp k_agent | k_ip | k_timeout | k_into) sp value)* (sp k_seconds)? result_clause?

file_statement ::= k_file sp k_read sp value result_clause?
                 | k_file sp k_write sp value sp k_to sp value
                 | k_file sp (k_delete | k_mkdir | k_list | k_exists | k_stat) sp value result_clause?
                 | k_file sp (k_move | k_copy) sp value sp k_to sp value
header_statement ::= k_header sp value (sp k_as sp value)?
wait_sleep_statement ::= k_wait sp k_for sp reference (sp value sp k_seconds)? result_clause?
                       | k_sleep sp value (sp (k_milliseconds | k_second | k_seconds | k_minute | k_minutes | k_hour | k_hours))?

# Condition precedence: AND binds tighter than OR.
condition ::= condition_and (sp k_or sp condition_and)*
condition_and ::= predicate (sp k_and sp predicate)*
predicate ::= (k_some sp)? value (sp comparison | sp k_contains sp value)?
comparison ::= (k_is | k_are) sp
               (k_not sp k_identical sp k_to sp value
               | k_not sp k_equal sp k_to sp value
               | k_identical sp k_to sp value
               | k_equal sp k_to sp value
               | k_greater sp k_than sp k_or sp k_equal sp k_to sp value
               | k_less sp k_than sp k_or sp k_equal sp k_to sp value
               | k_greater sp k_than sp value
               | k_less sp k_than sp value
               | k_not sp k_set
               | k_set
               | k_not sp k_array
               | k_array
               | k_not sp k_empty
               | k_empty
               | k_not sp k_null
               | k_null
               | k_waiting
               | k_infinite
               | k_true
               | k_false)

value_expression ::= value (gap "&" gap value)*
value ::= literal
        | reference
        | persistent_reference
        | of_reference
        | bracket_value
        | object_value
        | "(" value ")"

literal ::= string_literal | number | k_true | k_false | k_null
string_literal ::= double_quoted_string | single_quoted_string | raw_string
double_quoted_string ::= "\"" ([^"\\] | "\\" .)* "\""
single_quoted_string ::= "'" ([^'\\] | "\\" .)* "'"
raw_string ::= "`" ("\\`" | [^`])* "`"

reference ::= variable_access | global_access | this_context_reference | this_object_reference
this_context_reference ::= "!" k_this "(" value? ")" selector*
this_object_reference ::= k_this selector*
variable_access ::= variable selector*
global_access ::= "!" identifier selector*
persistent_reference ::= k_persistent sp variable selector*
consistent_reference ::= k_consistent sp value
variable ::= "?" identifier
selector ::= "(" value ")"
of_reference ::= value (sp k_of sp value)* sp k_of sp reference

bracket_value ::= "[" (inline_operation | array_items)? "]"
array_items ::= value (sp k_and sp value)*
object_value ::= k_new sp k_object ("[" object_fields "]")?
inline_operation ::= k_calculate sp math_expression
                  | k_run sp k_persistent sp identifier (sp k_with sp value (sp k_and sp value)*)?
                  | k_run sp identifier (sp k_with sp value (sp k_and sp value)*)?
                  | consistent_reference
                  | feature_head (sp feature_argument)*
                  | value_expression

math_expression ::= additive_expression
additive_expression ::= multiplicative_expression (gap ("+" | "-") gap multiplicative_expression)*
multiplicative_expression ::= unary_expression (gap ("*" | "/") gap unary_expression)*
unary_expression ::= ("+" | "-")? math_primary
math_primary ::= number
               | reference
               | function_call
               | "(" math_expression ")"
               | bracket_value
function_call ::= identifier "(" (math_expression ("," math_expression)*)? ")"
number ::= [+-]? [0-9]+ ("." [0-9]+)? ([eE] [+-]? [0-9]+)?

# Feature commands: command heads are drawn from the published Verb Reference.
# This fallback gives the model broad command-family coverage, not exact per-verb validation.
extension_statement ::= (variable_access sp)? feature_head (sp feature_argument)* result_clause?
feature_head ::= k_absolute | k_account | k_add | k_animate | k_app | k_append | k_applicate | k_assign | k_audio
               | k_auth | k_background | k_bim | k_block | k_book | k_browser | k_bridge | k_build | k_cache
               | k_calculate | k_calendar | k_call | k_cancel | k_cast | k_chat | k_check | k_class | k_clear
               | k_clone | k_code | k_column | k_commit | k_compress | k_config | k_connect | k_consistent | k_convert
               | k_cookie | k_count | k_cron | k_currency | k_database | k_db | k_case | k_default | k_decode
               | k_decrypt | k_deduplicate | k_delete | k_describe | k_directive | k_divide | k_dns | k_doc | k_domain
               | k_download | k_drive | k_drop | k_editor | k_email | k_emit | k_encode | k_encrypt | k_exit
               | k_export | k_external | k_factorial | k_fetch | k_fibonacci | k_file | k_filter | k_find | k_first
               | k_flatten | k_folder | k_forget | k_format | k_ftp | k_gather | k_generate | k_geoip | k_get
               | k_graph | k_graphic | k_group | k_hash | k_header | k_html | k_http | k_image | k_imap
               | k_import | k_include | k_insert | k_join | k_json | k_key | k_kill | k_label | k_list
               | k_load | k_log | k_logarithm | k_mail | k_map | k_material | k_matrix | k_media | k_mesh
               | k_modulo | k_move | k_multiply | k_multiarray | k_network | k_notification | k_notify | k_new | k_ocr | k_onbrowser
               | k_operation | k_outbound | k_parse | k_password | k_pixel | k_power | k_presentation | k_prime | k_push
               | k_qr | k_query | k_raise | k_randomize | k_read | k_recall | k_receive | k_redirect | k_remember
               | k_remind | k_remove | k_replace | k_reset | k_resize | k_restore | k_return | k_reverse | k_rich
               | k_round | k_run | k_save | k_schedule | k_scene | k_search | k_select | k_send | k_share
               | k_show | k_sim | k_sleep | k_slice | k_slide | k_sort | k_spawn | k_split | k_square
               | k_ssh | k_start | k_status | k_storage | k_string | k_subdomain | k_subtract | k_sum | k_sync
               | k_table | k_tag | k_tcp | k_time | k_timeline | k_token | k_transcode | k_trim | k_udp
               | k_unset | k_update | k_upload | k_user | k_ux | k_verify | k_video | k_wait | k_watch
               | k_weather | k_websocket | k_webassembly | k_webhook | k_webrtc | k_write
feature_argument ::= value | feature_option | "," | ":" | "=" | "/" | "-" | "+" | "&"
feature_option ::= k_board | k_expose | k_live | k_material | k_open | k_pcb | k_point | k_polygon | k_pop3 | k_ports | k_primitive | k_raw | k_render | k_route | k_smooth | k_solve | k_attendee | k_bind | k_compare | k_domains | k_login | k_register | k_revoke | k_ssl | k_unbind | k_absolute | k_account | k_add | k_aes | k_agent | k_all | k_animate | k_app | k_append | k_applicate | k_are | k_array | k_as | k_ascending | k_assign | k_audio | k_auth | k_background | k_base64 | k_bim | k_block | k_body | k_book | k_bool | k_bridge | k_browser | k_build | k_by | k_cache | k_calculate | k_calendar | k_call | k_cancel | k_case | k_cast | k_catch | k_chacha20 | k_chat | k_check | k_class | k_clear | k_clone | k_code | k_collapse | k_color | k_column | k_commit | k_compress | k_config | k_connect | k_consistent | k_contains | k_convert | k_cookie | k_copy | k_count | k_create | k_cron | k_csv | k_curl | k_currency | k_database | k_date | k_day | k_days | k_db | k_decimals | k_decode | k_decrypt | k_deduplicate | k_default | k_delete | k_des | k_descending | k_describe | k_description | k_directive | k_divide | k_dns | k_doc | k_domain | k_download | k_drive | k_drop | k_editor | k_email | k_emit | k_empty | k_encode | k_encrypt | k_equal | k_error | k_exists | k_export | k_false | k_fetch | k_fibonacci | k_file | k_filter | k_find | k_first | k_flatten | k_folder | k_for | k_forget | k_format | k_from | k_ftp | k_fullname | k_gather | k_generate | k_geoip | k_get | k_graph | k_graphic | k_greater | k_group | k_hash | k_header | k_height | k_hex | k_hmac | k_hour | k_hours | k_html | k_http | k_identical | k_image | k_imap | k_import | k_include | k_infinite | k_insert | k_integer | k_into | k_ip | k_is | k_join | k_json | k_key | k_keys | k_kill | k_label | k_last | k_layers | k_length | k_less | k_level | k_list | k_load | k_log | k_logarithm | k_lowercase | k_mail | k_map | k_markdown | k_media | k_merge | k_mesh | k_method | k_milliseconds | k_minute | k_minutes | k_mkdir | k_modify | k_modulo | k_month | k_months | k_move | k_multiarray | k_multiply | k_name | k_network | k_new | k_not | k_notification | k_notify | k_null | k_number | k_object | k_ocr | k_of | k_off | k_on | k_onbrowser | k_once | k_opacity | k_oqlobject | k_outbound | k_parse | k_persist | k_persistent | k_pixel | k_position | k_presentation | k_prime | k_promise | k_proxy | k_push | k_qr | k_query | k_randomize | k_range | k_raise | k_read | k_recall | k_receive | k_redirect | k_remember | k_remind | k_remove | k_replace | k_required | k_reset | k_resize | k_restore | k_reverse | k_rotation | k_run | k_save | k_scale | k_scene | k_schedule | k_scientific | k_search | k_second | k_seconds | k_select | k_send | k_sha1 | k_sha256 | k_sha384 | k_sha512 | k_share | k_shortname | k_show | k_sim | k_size | k_sleep | k_slice | k_slide | k_some | k_sort | k_spawn | k_split | k_square | k_ssh | k_start | k_stat | k_status | k_step | k_storage | k_string | k_subdomain | k_subtract | k_sum | k_sync | k_table | k_tag | k_tcp | k_than | k_this | k_time | k_timeline | k_timeout | k_timestamp | k_timezone | k_title | k_to | k_token | k_toml | k_transcode | k_trim | k_true | k_udp | k_unit | k_unset | k_update | k_upload | k_uppercase | k_url | k_user | k_ux | k_value | k_values | k_variable | k_verify | k_video | k_wait | k_waiting | k_warning | k_watch | k_weather | k_webassembly | k_webhook | k_webrtc | k_week | k_weeks | k_where | k_width | k_with | k_write | k_xml | k_yaml | k_year | k_years

identifier ::= [A-Za-z_] [A-Za-z0-9_]*

# Trivia and comments. Comments are non-nesting and may span lines.
gap ::= (ws | comment)*
sp ::= (ws | comment)+
ws ::= [ \t\r\n]+
comment ::= "(*" ([^*] | "*" [^)])* "*)"

# Case-insensitive keyword terminals.

k_after ::= [aA][fF][tT][eE][rR]
k_and ::= [aA][nN][dD]
k_or ::= [oO][rR]
k_if ::= [iI][fF]
k_while ::= [wW][hH][iI][lL][eE]
k_loop ::= [lL][oO][oO][pP]
k_to ::= [tT][oO]
k_step ::= [sS][tT][eE][pP]
k_set ::= [sS][eE][tT]
k_foreach ::= [fF][oO][rR][eE][aA][cC][hH]
k_as ::= [aA][sS]
k_switch ::= [sS][wW][iI][tT][cC][hH]
k_case ::= [cC][aA][sS][eE]
k_default ::= [dD][eE][fF][aA][uU][lL][tT]
k_new ::= [nN][eE][wW]
k_operation ::= [oO][pP][eE][rR][aA][tT][iI][oO][nN]
k_open ::= [oO][pP][eE][nN]
k_close ::= [cC][lL][oO][sS][eE]
k_emit ::= [eE][mM][iI][tT]
k_string ::= [sS][tT][rR][iI][nN][gG]
k_number ::= [nN][uU][mM][bB][eE][rR]
k_unset ::= [uU][nN][sS][eE][tT]
k_variable ::= [vV][aA][rR][iI][aA][bB][lL][eE]
k_calculate ::= [cC][aA][lL][cC][uU][lL][aA][tT][eE]
k_return ::= [rR][eE][tT][uU][rR][nN]
k_run ::= [rR][uU][nN]
k_exit ::= [eE][xX][iI][tT]
k_break ::= [bB][rR][eE][aA][kK]
k_continue ::= [cC][oO][nN][tT][iI][nN][uU][eE]
k_catch ::= [cC][aA][tT][cC][hH]
k_error ::= [eE][rR][rR][oO][rR]
k_warning ::= [wW][aA][rR][nN][iI][nN][gG]
k_promise ::= [pP][rR][oO][mM][iI][sS][eE]
k_array ::= [aA][rR][rR][aA][yY]
k_multiarray ::= [mM][uU][lL][tT][iI][aA][rR][rR][aA][yY]
k_object ::= [oO][bB][jJ][eE][cC][tT]
k_append ::= [aA][pP][pP][eE][nN][dD]
k_count ::= [cC][oO][uU][nN][tT]
k_collapse ::= [cC][oO][lL][lL][aA][pP][sS][eE]
k_flatten ::= [fF][lL][aA][tT][tT][eE][nN]
k_keys ::= [kK][eE][yY][sS]
k_values ::= [vV][aA][lL][uU][eE][sS]
k_remove ::= [rR][eE][mM][oO][vV][eE]
k_key ::= [kK][eE][yY]
k_from ::= [fF][rR][oO][mM]
k_search ::= [sS][eE][aA][rR][cC][hH]
k_for ::= [fF][oO][rR]
k_join ::= [jJ][oO][iI][nN]
k_slice ::= [sS][lL][iI][cC][eE]
k_sort ::= [sS][oO][rR][tT]
k_ascending ::= [aA][sS][cC][eE][nN][dD][iI][nN][gG]
k_descending ::= [dD][eE][sS][cC][eE][nN][dD][iI][nN][gG]
k_by ::= [bB][yY]
k_with ::= [wW][iI][tT][hH]
k_reverse ::= [rR][eE][vV][eE][rR][sS][eE]
k_all ::= [aA][lL][lL]
k_once ::= [oO][nN][cC][eE]
k_replace ::= [rR][eE][pP][lL][aA][cC][eE]
k_length ::= [lL][eE][nN][gG][tT][hH]
k_uppercase ::= [uU][pP][pP][eE][rR][cC][aA][sS][eE]
k_lowercase ::= [lL][oO][wW][eE][rR][cC][aA][sS][eE]
k_trim ::= [tT][rR][iI][mM]
k_select ::= [sS][eE][lL][eE][cC][tT]
k_split ::= [sS][pP][lL][iI][tT]
k_date ::= [dD][aA][tT][eE]
k_time ::= [tT][iI][mM][eE]
k_get ::= [gG][eE][tT]
k_day ::= [dD][aA][yY]
k_month ::= [mM][oO][nN][tT][hH]
k_fullname ::= [fF][uU][lL][lL][nN][aA][mM][eE]
k_shortname ::= [sS][hH][oO][rR][tT][nN][aA][mM][eE]
k_first ::= [fF][iI][rR][sS][tT]
k_last ::= [lL][aA][sS][tT]
k_cast ::= [cC][aA][sS][tT]
k_bool ::= [bB][oO][oO][lL]
k_json ::= [jJ][sS][oO][nN]
k_oqlobject ::= [oO][qQ][lL][oO][bB][jJ][eE][cC][tT]
k_parse ::= [pP][aA][rR][sS][eE]
k_encode ::= [eE][nN][cC][oO][dD][eE]
