block ::= k-OPEN (ws1 sequence)? ws1 k-CLOSE
block-part ::= ((k-AS ws1 block-cascade) | (block-cascade))
block-cascade ::= block (ws1 k-OR ws1 k-IF ws1 condition ws1 block (ws1 k-OR ws1 k-IF ws1 condition ws1 block)*)? (ws1 k-OR ws1 block)?
capture ::= k-SET ws1 (variable | k-PROMISE ws variable | k-PERSISTENT ws variable | k-CONSISTENT ws string | writable-global)
capture-var ::= k-SET ws1 (variable | k-PROMISE ws variable | k-PERSISTENT ws variable | k-CONSISTENT ws string)
set-var ::= k-SET ws variable
expression ::= sum (ws "&" ws sum (ws "&" ws sum)*)?
sum ::= (
      product ws1 (k-FIRST ws1 k-DAY | k-LAST ws1 k-DAY)
    | product (ws ("+" ws product (ws1 time-unit)? | "-" ws product (ws1 (time-unit | k-AS ws1 time-unit))?) (ws ("+" ws product (ws1 time-unit)? | "-" ws product (ws1 (time-unit | k-AS ws1 time-unit))?))*)?
  )
time-unit ::= (
      k-DAY
    | k-DAYS
    | k-WEEK
    | k-WEEKS
    | k-MONTH
    | k-MONTHS
    | k-YEAR
    | k-YEARS
    | k-HOUR
    | k-HOURS
    | k-MINUTE
    | k-MINUTES
    | k-SECOND
    | k-SECONDS
  )
product ::= unary (ws ("*" | "/") ws unary (ws ("*" | "/") ws unary)*)?
unary ::= "-" ws unary | of-chain
of-chain ::= atom (ws1 k-OF ws1 atom (ws1 k-OF ws1 atom)*)? (ws1 k-OF ws keyed-global-name)?
atom ::= (
      string
    | number (ws "%")?
    | variable (ws index (ws index)*)?
    | k-THIS (ws index (ws index)*)?
    | k-TRUE
    | k-FALSE
    | k-NULL
    | k-PERSISTENT ws variable (ws index (ws index)*)?
    | k-COUNT ws (variable (ws index (ws index)*)? | "(" ws expression ws ")" | bracket-value (ws index (ws index)*)?)
    | function-call
    | "(" ws expression ws ")"
    | bracket-value (ws index (ws index)*)?
    | global-value
  )
number ::= integer | float
index ::= "(" ws expression ws ")"
function-call ::= (k-ABS | k-ROUND | k-FLOOR | k-CEIL | k-SQRT | k-POWER | k-MOD) ws "(" ws expression (ws "," ws expression (ws "," ws expression)*)? ws ")"
bracket-value ::= (
      "[" ws "]"
    | "[" ws statement ws "]"
    | "[" ws expression ws1 k-AS ws1 literal-value (ws1 k-AND ws1 expression ws1 k-AS ws1 literal-value (ws1 k-AND ws1 expression ws1 k-AS ws1 literal-value)*)? ws "]"
    | "[" ws expression (ws1 k-AND ws1 literal-value (ws1 k-AND ws1 literal-value)*)? ws "]"
  )
literal-value ::= statement | expression
global-value ::= (
      g-THAT (ws index (ws index)*)?
    | (g-NOW | g-IP | g-UA | g-QUERY | g-VALUE) (ws index (ws index)*)?
    | (g-THIS | g-ERROR) ws "(" ws string ws ")" (ws index (ws index)*)?
    | keyed-global-name ws ("(" ws expression ws ")" (ws "(" ws expression ws ")")*)
  )
keyed-global-name ::= (
      g-GLOBAL
    | g-GLOBALS
    | g-GET
    | g-POST
    | g-REQUEST
    | g-SERVER
    | g-ENV
    | g-FILES
    | g-SESSION
    | g-COOKIE
  )
writable-global ::= (
      (g-GLOBAL | g-GET | g-POST | g-COOKIE | g-SESSION | g-HEADER) ws "(" ws string ws ")"
    | g-GLOBALS ws "(" ws string ws ")" ws "(" ws string ws ")"
  )
target ::= (
      variable (ws "(" ws expression (ws "," ws expression (ws "," ws expression)*)? ws ")" (ws "(" ws expression (ws "," ws expression (ws "," ws expression)*)? ws ")")*)?
    | k-THIS ws (index (ws index)*)
    | string (ws k-OF ws1 atom (ws1 k-OF ws1 atom)*)? ws1 k-OF ws1 (variable | k-THIS) (ws index (ws index)*)?
    | writable-global
  )
name ::= word ("-" (word | integer))* | k-QUERY ws1 k-STRING | k-DATE ws1 k-AND ws1 k-TIME
format-word ::= string | word | integer word?
condition ::= condition-and (ws1 k-OR ws1 condition-and (ws1 k-OR ws1 condition-and)*)?
condition-and ::= comparison (ws1 k-AND ws1 comparison (ws1 k-AND ws1 comparison)*)?
comparison ::= ((k-SOME ws1 expression (ws1 (k-CONTAINS ws1 expression (ws1 (k-IS | k-ARE) (ws1 k-NOT)? ws1 (k-TRUE | k-FALSE))? | (k-IS | k-ARE) (ws1 k-NOT)? ws1 comparison-test))?) | (expression (ws1 (k-CONTAINS ws1 expression (ws1 (k-IS | k-ARE) (ws1 k-NOT)? ws1 (k-TRUE | k-FALSE))? | (k-IS | k-ARE) (ws1 k-NOT)? ws1 comparison-test))?))
comparison-test ::= (
      k-EQUAL ws1 k-TO ws1 expression
    | k-IDENTICAL ws1 k-TO ws1 expression
    | k-GREATER ws1 k-THAN (ws1 k-OR ws1 k-EQUAL ws1 k-TO)? ws1 expression
    | k-LESS ws1 k-THAN (ws1 k-OR ws1 k-EQUAL ws1 k-TO)? ws1 expression
    | k-WAITING
    | k-SET
    | k-EMPTY
    | k-NULL
    | k-TRUE
    | k-FALSE
    | k-ARRAY
    | k-OBJECT
    | k-NUMBER
    | k-STRING
    | k-BOOLEAN
  )
where-clause ::= where-and (ws1 k-OR ws1 where-and (ws1 k-OR ws1 where-and)*)?
where-and ::= where-test (ws1 k-AND ws where-column-test (ws1 k-AND ws where-column-test)*)?
where-test ::= atom ws1 where-rest
where-column-test ::= (string | variable (ws index (ws index)*)?) ws1 where-rest
where-rest ::= ((k-OF ws1 atom ws1 (k-CONTAINS ws1 atom | (k-IS | k-ARE) (ws1 k-NOT)? ws1 where-op)) | ((k-CONTAINS ws1 atom | (k-IS | k-ARE) (ws1 k-NOT)? ws1 where-op)))
where-op ::= (
      (k-EQUAL | k-IDENTICAL) ws1 k-TO ws1 atom (ws1 k-OF ws1 atom)?
    | (k-GREATER | k-LESS) ws1 k-THAN (ws1 k-OR ws1 k-EQUAL ws1 k-TO)? ws1 atom
    | (((k-PREFIX | k-SUFFIX) ws1 k-SIMILAR ws1 k-TO ws1 atom) | (k-SIMILAR ws1 k-TO ws1 atom))
    | k-NULL
    | k-EMPTY
    | k-TRUE
    | k-FALSE
  )
column-list ::= column-def (ws1 k-AND ws1 column-def (ws1 k-AND ws1 column-def)*)?
column-def ::= k-ADD ws1 atom (ws1 column-word (ws1 column-word)*)? ws1 k-TYPE ws1 (k-STRING | k-NUMBER | k-DATE | k-BOOL) (ws1 column-word (ws1 column-word)*)?
column-word ::= (
      k-LENGTH ws1 atom
    | k-DEFAULT ws1 atom
    | k-HEADING ws1 atom
    | k-SOURCE ws1 k-TYPE ws1 atom
    | k-PRIMARY
    | k-AUTOINCREMENT
    | k-UNIQUE
    | k-REQUIRED
    | k-AUTOTIMESTAMP
    | k-AUTOUPDATED
  )
pairs ::= pair (ws1 k-AND ws1 pair (ws1 k-AND ws1 pair)*)?
pair ::= expression ws1 k-AS ws1 expression
value-list ::= expression (ws1 k-AND ws1 expression (ws1 k-AND ws1 expression)*)?
coordinate ::= k-TOP | k-BOTTOM | k-LEFT | k-RIGHT | k-CENTRE | k-CENTER | number ws "%" | expression
vector ::= expression (ws "," ws expression (ws "," ws expression)*)?
device-command ::= "[" device-text "]"
device-text ::= (device-char | "[" device-text "]")*
bracket-pairs ::= "[" (ws pair (ws1 k-AND ws1 pair (ws1 k-AND ws1 pair)*)?)? ws "]"
scheduled-action ::= (source-token (ws1 source-token)*)
set-into-global ::= k-SET ws string ws k-AS ws1 atom ws1 k-OF ws (g-GLOBAL | g-POST | g-GET | g-COOKIE | g-SESSION | g-HEADER)
foreach-statement ::= k-FOREACH ws1 expression ws1 k-SET ws variable (ws1 k-AS ws variable)? ws1 block
switch-statement ::= k-SWITCH ws1 expression ws1 k-OPEN (ws1 switch-arm (ws1 switch-arm)*)? ws1 k-CLOSE
switch-arm ::= ((k-CASE ws1 expression (ws1 k-CASE ws1 expression)*) | k-DEFAULT) (ws1 switch-body)?
switch-body ::= (
      k-BREAK
    | or-chain (ws1 k-AFTER ws1 or-chain (ws1 k-AFTER ws1 or-chain)*)? (ws1 k-AFTER (ws1 k-BREAK)?)?
  )
catch-statement ::= k-CATCH ws1 k-ERROR (ws1 (capture | block) (ws1 (capture | block))*)?
wait-for-statement ::= k-WAIT ws1 k-FOR ws1 expression (ws1 (number | variable (ws index (ws index)*)?) (ws1 expression-tail)? ws1 (k-SECONDS | k-SECOND))? (ws1 set-var)?
expression-tail ::= ((k-OF ws1 atom | ("*" | "/") ws unary | ("+" | "-") ws product | "&" ws sum) (ws1 (k-OF ws1 atom | ("*" | "/") ws unary | ("+" | "-") ws product | "&" ws sum))*)
send-statement ::= k-SEND ws1 expression ws1 expression
header-bare ::= k-HEADER ws1 word (ws1 header-part (ws1 header-part)*)?
operation-def ::= k-NEW (ws1 k-PERSISTENT)? ws1 k-OPERATION ws1 word (ws1 k-WITH ws parameter (ws1 k-AND ws parameter (ws1 k-AND ws parameter)*)?)? ws1 block
parameter ::= variable (ws1 k-AS ws1 (k-STRING | k-NUMBER | k-BOOL | k-DATE) (ws1 (k-REQUIRED | k-DEFAULT ws1 expression))?)?
run-statement ::= k-RUN (ws1 k-PERSISTENT)? ws1 word (ws1 k-WITH ws1 expression (ws1 k-AND ws1 expression (ws1 k-AND ws1 expression)*)?)? (ws1 set-var)?
class-def ::= k-NEW ws1 k-CLASS ws1 word (ws1 k-EXTENDS ws1 word)? (ws1 k-WITH ws class-property (ws1 k-AND ws class-property (ws1 k-AND ws class-property)*)?)?
class-property ::= string ws k-AS ws1 (k-METHOD ws1 block | (k-STRING | k-NUMBER | k-BOOL | k-DATE) (ws1 (k-REQUIRED | k-DEFAULT ws1 atom) (ws1 (k-REQUIRED | k-DEFAULT ws1 atom))*)?)
assign-material-subject-first ::= variable ws1 k-ASSIGN ws1 k-MATERIAL ws1 (expression (ws1 capture)? | capture ws1 expression)
query-def ::= k-NEW (ws1 k-PERSISTENT)? ws1 k-QUERY (ws1 (k-CASE ws string | k-SEPARATOR ws string) (ws (k-CASE ws string | k-SEPARATOR ws string))*)? (ws1 k-AS)? ws1 k-OPEN ws1 query-steps ws1 k-CLOSE
query-steps ::= query-step (ws1 k-FALLBACK ws1 query-step-plain)? (ws1 k-NEXT ws1 query-step (ws1 k-FALLBACK ws1 query-step-plain)? (ws1 k-NEXT ws1 query-step (ws1 k-FALLBACK ws1 query-step-plain)?)*)? ws1 k-END
query-step ::= variable ws1 k-STEP (ws1 k-SKIPPABLE)? (ws1 sequence)? | query-step-plain
query-step-plain ::= k-STEP ws1 (k-VALUE (ws1 (k-NUMBER | k-STRING))? (ws1 k-MIN ws1 number)? (ws1 k-MAX ws1 number)? (ws1 k-EXCEPT ws string (ws k-AND ws string (ws k-AND ws string)*)?)? | string (ws k-OR ws1 k-STEP ws string (ws k-OR ws1 k-STEP ws string)*)?) (ws1 k-SKIPPABLE)? (ws1 sequence)?
query-statement ::= k-QUERY ws1 ((variable (ws index (ws index)*)? | string) (ws1 expression-tail)? (ws1 (k-FROM ws1 expression | k-SET ws variable) (ws1 (k-FROM ws1 expression | k-SET ws variable))*)? | (phrase-word-token | number | k-SET) (ws1 phrase-item (ws1 phrase-item)*)? (ws1 set-var)?)
