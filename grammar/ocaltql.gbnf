# ---------- tokens ----------
# Between tokens: spaces, tabs, new lines and (* comments *).
# A full stop between tokens is ignored, as in the language: EMIT "Hi".
ws        ::= ([ \t\r\n.] | comment)*
ws1       ::= ([ \t\r\n.] | comment) ([ \t\r\n.] | comment)*
comment   ::= "(*" ([^*] | "*"+ [^*)])* "*"+ ")"
string    ::= "\"" ([^"\\] | "\\" [^\x00])* "\"" | "'" ([^'\\] | "\\" [^\x00])* "'" | "`" ([^`\\] | "\\" [^\x00])* "`"
integer   ::= [0-9]+
float     ::= [0-9]+ "." [0-9]+
variable  ::= "?" [a-zA-Z0-9_]+
word      ::= [a-zA-Z_] [a-zA-Z0-9_]*
device-char ::= [^\[\]]

