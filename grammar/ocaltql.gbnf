source-token ::= source-word | string | integer | float | variable | "!" word | [&+*/()%,\[\]-]
source-word ::= (
      ([A-NP-Z_a-np-z] [0-9A-Z_a-z])
    | ([Oo] [0-9A-QS-Z_a-qs-z])
    | ([B-RT-Z_b-rt-z] [0-9A-Z_a-z] [0-9A-Z_a-z])
    | ([Aa] [0-9A-MO-Z_a-mo-z] [0-9A-Z_a-z])
    | ([Aa][Nn] [0-9A-CE-Z_a-ce-z])
    | ([Ss] [0-9A-DF-Z_a-df-z] [0-9A-Z_a-z])
    | ([Ss][Ee] [0-9A-SU-Z_a-su-z])
    | ([B-Z_b-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z])
    | ([Aa] [0-9A-EG-Z_a-eg-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z])
    | ([Aa][Ff] [0-9A-SU-Z_a-su-z] [0-9A-Z_a-z] [0-9A-Z_a-z])
    | ([Aa][Ff][Tt] [0-9A-DF-Z_a-df-z] [0-9A-Z_a-z])
    | ([Aa][Ff][Tt][Ee] [0-9A-QS-Z_a-qs-z])
    | ([A-Z_a-z])
    | ([A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z])
    | ([A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z]*)
  )
phrase-word-token ::= (
      ([A-NP-Z_a-np-z] [0-9A-Z_a-z])
    | ([Oo] [0-9A-QS-Z_a-qs-z])
    | ([B-RT-Z_b-rt-z] [0-9A-Z_a-z] [0-9A-Z_a-z])
    | ([Aa] [0-9A-MO-Z_a-mo-z] [0-9A-Z_a-z])
    | ([Aa][Nn] [0-9A-CE-Z_a-ce-z])
    | ([Ss] [0-9A-DF-Z_a-df-z] [0-9A-Z_a-z])
    | ([Ss][Ee] [0-9A-SU-Z_a-su-z])
    | ([A-NP-Z_a-np-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z])
    | ([Oo] [0-9A-OQ-Z_a-oq-z] [0-9A-Z_a-z] [0-9A-Z_a-z])
    | ([Oo][Pp] [0-9A-DF-Z_a-df-z] [0-9A-Z_a-z])
    | ([Oo][Pp][Ee] [0-9A-MO-Z_a-mo-z])
    | ([BD-Z_bd-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z])
    | ([Aa] [0-9A-EG-Z_a-eg-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z])
    | ([Aa][Ff] [0-9A-SU-Z_a-su-z] [0-9A-Z_a-z] [0-9A-Z_a-z])
    | ([Aa][Ff][Tt] [0-9A-DF-Z_a-df-z] [0-9A-Z_a-z])
    | ([Aa][Ff][Tt][Ee] [0-9A-QS-Z_a-qs-z])
    | ([Cc] [0-9A-KM-Z_a-km-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z])
    | ([Cc][Ll] [0-9A-NP-Z_a-np-z] [0-9A-Z_a-z] [0-9A-Z_a-z])
    | ([Cc][Ll][Oo] [0-9A-RT-Z_a-rt-z] [0-9A-Z_a-z])
    | ([Cc][Ll][Oo][Ss] [0-9A-DF-Z_a-df-z])
    | ([A-Z_a-z])
    | ([A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z] [0-9A-Z_a-z]*)
  )

