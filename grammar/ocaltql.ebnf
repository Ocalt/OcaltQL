/* CAD <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     MATE <component>
     FACE <f> [repeatable]
     AXIS <a> [repeatable]
     COINCIDENT WITH <component>
     CONCENTRIC WITH <component>
     OFFSET <n>
     INSERT COMPONENT <part>
     AS <name>
     EDGE AT <xyz>
     FACE AT <xyz>
     RECTANGLE FROM <xy>
     CIRCLE CENTER <xy>
     ARC CENTER <xy>
     TO <xy>
     RADIUS <n>
     START <deg>
     EXTRACT POSITION OF <component>
     END <deg>
     INTERFERENCE CHECK
     MASS <kg>
     INERTIA <xyz>
     JOINT REVOLUTE
     AT <xyz>
     BETWEEN <component>
     AND <component>
     TORQUE <joint>
     AMOUNT <n>
     WAVEFORM <w>
     FREQUENCY <hz>
     MOTION SIMULATE
     DURATION <s>
     STEP <s>
     MEASURE
   returns a value: capture it with SET ?var */
verb-cad          ::= "CAD" verb-cad-part*
verb-cad-part     ::= expression | "MATE" expression | "FACE" expression | "AXIS" expression
                    | "COINCIDENT" "WITH" expression | "CONCENTRIC" "WITH" expression
                    | "OFFSET" expression | "INSERT" "COMPONENT" expression | "AS" expression
                    | "EDGE" "AT" vector | "FACE" "AT" vector | "RECTANGLE" "FROM" vector
                    | "CIRCLE" "CENTER" vector | "ARC" "CENTER" vector | "TO" vector
                    | "RADIUS" expression | "START" expression
                    | "EXTRACT" "POSITION" "OF" expression | "END" expression
                    | "INTERFERENCE" "CHECK" | "MASS" expression | "INERTIA" vector
                    | "JOINT" "REVOLUTE" | "AT" vector | "BETWEEN" expression | "AND" expression
                    | "TORQUE" expression | "AMOUNT" expression | "WAVEFORM" expression
                    | "FREQUENCY" expression | "MOTION" "SIMULATE" | "DURATION" expression
                    | "STEP" expression | "MEASURE" | capture

