/* MAIL
   modifiers, in any order, each once unless repeatable:
     TEXT
     HTML
     BODY <content> [required]
     TO <recipients> [required]
     SUBJECT <text> [required]
     CC <recipients>
     BCC <recipients>
     HEADER <line> [repeatable]
     REPLY TO <address>
     ATTACH <path>
   returns nothing (no SET capture) */
verb-mail         ::= "MAIL" verb-mail-part*
