/* DIRECTIVE <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     CLIPBOARD
     PERMS
     EXEC <cmd>
     DOWNLOAD <path>
     UPLOAD <path>
     SCREENSHOT
     WAKE <mac>
     KILL <pid>
     TUNNEL
     PORT <n>
     TO <path>
     BACKGROUND
     READ <path>
     REDIRECT <url>
     WRITE <path>
     CONTENT <data>
     MOUSE <action>
     KEYBOARD <keys>
     POINTER
     COORDINATES
     X <n>
     Y <n>
     VIEW
     SERVE <path>
     SERVE FOLDER <path>
     LISTING
     ONDEVICE [command]
     BIND [pairs]
     INTO CHANNEL <channel>
     WEBASSEMBLY GRANT <var>
     AS <alias>
     WEBASSEMBLY TYPE <lang>
     WEBASSEMBLY SERVE <name>
     WEBASSEMBLY PROCESSES
     WEBASSEMBLY STOP <name>
     TYPE <lang>
     ENTER <code>
     ON <port>
     WINDOW
     WINDOW CLOSE
     PAYLOAD <html>
     URL <address>
     BASE <folder>
     RESIZE
     SIZE WIDTH <px>
     HEIGHT <px>
     MAXIMIZED
     FULLSCREEN
     SCREEN
     ON DISPLAY <n|"all">
     POLL <n>
     QUALITY <1-100>
     WIDTH <px>
     FPS <n>
     UPDATE
     LIST DRIVES
     POCKET <name>
     WITH <args>
     LIST FROM <path>
     TTL <seconds>
     SECONDS  (also written: SECOND)
     MINUTES  (also written: MINUTE)
   returns a value: capture it with SET ?var */
verb-directive    ::= "DIRECTIVE" verb-directive-part*
verb-directive-part ::= expression | "CLIPBOARD" | "PERMS" | "EXEC" expression
                      | "DOWNLOAD" expression | "UPLOAD" expression | "SCREENSHOT"
                      | "WAKE" expression | "KILL" expression | "TUNNEL" | "PORT" expression
                      | "TO" expression | "BACKGROUND" | "READ" expression
                      | "REDIRECT" expression | "WRITE" expression | "CONTENT" expression
                      | "MOUSE" expression | "KEYBOARD" expression | "POINTER" | "COORDINATES"
                      | "X" expression | "Y" expression | "VIEW" | "SERVE" expression
                      | "SERVE" "FOLDER" expression | "LISTING" | "ONDEVICE" device-command
                      | "BIND" bracket-pairs | "INTO" "CHANNEL" expression
                      | "WEBASSEMBLY" "GRANT" expression | "AS" expression
                      | "WEBASSEMBLY" "TYPE" expression | "WEBASSEMBLY" "SERVE" expression
                      | "WEBASSEMBLY" "PROCESSES" | "WEBASSEMBLY" "STOP" expression
                      | "TYPE" expression | "ENTER" expression | "ON" expression | "WINDOW"
                      | "WINDOW" "CLOSE" | "PAYLOAD" expression | "URL" expression
                      | "BASE" expression | "RESIZE" | "SIZE" "WIDTH" expression
                      | "HEIGHT" expression | "MAXIMIZED" | "FULLSCREEN" | "SCREEN"
                      | "ON" "DISPLAY" expression | "POLL" expression | "QUALITY" expression
                      | "WIDTH" expression | "FPS" expression | "UPDATE" | "LIST" "DRIVES"
                      | "POCKET" expression | "WITH" expression | "LIST" "FROM" expression
                      | "TTL" expression | ( "SECONDS" | "SECOND" ) | ( "MINUTES" | "MINUTE" )
                      | capture

