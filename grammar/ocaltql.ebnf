                    | "RENDER" "WALKTHROUGH" | "RENDER" "PANORAMA" | "FRAMES" expression
                    | "TO" expression | "PATH" expression | "DURATION" expression
                    | "PLACE" expression | "AT" vector | "ROTATION" vector
                    | "CAMERA" "AT" vector | "LOOKAT" vector | "FOV" expression
                    | "SAVE" "INTO" expression | "SAVE" | "LIST" | "SUN" | "DIRECTION" vector
                    | "INTENSITY" expression | "RENDER" "INTO" expression | "RESOLUTION" vector
                    | "SKY" "HDRI" expression | "SAMPLES" expression | "WIDTH" expression
                    | "HEIGHT" expression | capture

