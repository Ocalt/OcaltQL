verb-kill-session ::= "KILL" "SESSION"

/* CRAWL <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     DEPTH <n>
     LIMIT <n>
     WITHIN DOMAIN  (also written: WITHIN SITE, SAME SITE)
     ANYWHERE
     MATCH <pattern>
     EXCLUDE <pattern>
     FLAT
     TIMEOUT <n>
     SECONDS  (also written: SECOND)
   returns a value: capture it with SET ?var */
verb-crawl        ::= "CRAWL" verb-crawl-part*
verb-crawl-part   ::= expression | "DEPTH" expression | "LIMIT" expression
                    | ( "WITHIN" "DOMAIN" | "WITHIN" "SITE" | "SAME" "SITE" ) | "ANYWHERE"
                    | "MATCH" expression | "EXCLUDE" expression | "FLAT" | "TIMEOUT" expression
                    | ( "SECONDS" | "SECOND" ) | capture

