/* ======================================================================
   OcaltQL grammar, in W3C EBNF.
   Guide: https://ql.ocalt.com/tutorial/grammar-parser

   Notation (W3C EBNF):
     a b        a then b          a | b      a or b
     a?         optional          a*         zero or more
     a+         one or more       ( )        grouping
     "WORD"     a keyword. Keywords are not case sensitive: SET, Set and
                set are the same word. Uppercase is the house style.
   Between any two tokens there may be spaces, tabs, new lines and
   comments. A full stop between tokens is ignored.
   ====================================================================== */

/* Generated from the OcaltQL runtime's verb table (456 verbs). Do not edit by hand. */

/* ======================================================================
   OcaltQL grammar, in W3C EBNF.
   Guide: https://ql.ocalt.com/tutorial/grammar-parser

   Notation (W3C EBNF):
     a b        a then b          a | b      a or b
     a?         optional          a*         zero or more
     a+         one or more       ( )        grouping
     "WORD"     a keyword. Keywords are not case sensitive: SET, Set and
                set are the same word. Uppercase is the house style.
   Between any two tokens there may be spaces, tabs, new lines and
   comments. A full stop between tokens is ignored.
   ====================================================================== */
/* ---------- Script structure ------------------------------------------- */
script            ::= sequence

/* AFTER runs the next part once the previous one has finished. It binds
     loosest. OR runs its right side only when the left side failed, gave
     false, an empty string, or SET a null. AND binds tightest: both sides
     run, and the next part waits for both. */
sequence          ::= or-chain ( "AFTER" or-chain )*

or-chain          ::= and-group ( "OR" and-group )*

and-group         ::= statement ( "AND" statement )*

/* A statement is one verb with everything that belongs to it. */
statement         ::= verb-emit | verb-sleep | verb-string | verb-number | verb-set
                    | set-into-global | verb-variable | verb-unset | verb-unset-persistent
                    | verb-collapse | verb-calculate | verb-if | verb-while | verb-loop
                    | verb-break | verb-continue | verb-exit | operation-def | run-statement
                    | verb-return | verb-new-array | verb-new-multiarray | verb-new-object
                    | verb-append | verb-count | verb-keys | verb-values | verb-remove-key
                    | verb-reverse-array | verb-deduplicate | verb-flatten | verb-search-array
                    | verb-search-object | verb-join | verb-join-array | verb-slice | verb-sort
                    | verb-merge-array | verb-merge-object | foreach-statement | verb-length
                    | verb-string-uppercase | verb-string-lowercase | verb-trim-string
                    | verb-reverse-string | verb-split | verb-search-string | verb-select-string
                    | verb-replace-string | switch-statement | catch-statement | verb-file-write
                    | verb-file-read | verb-file-exists | verb-file-stat | verb-file-list
                    | verb-file-mkdir | verb-file-delete | verb-file-move | verb-file-copy
                    | verb-file-compress | verb-file-extract | verb-file-share
                    | verb-file-share-list | verb-file-unshare | verb-file-unshare-all
                    | verb-storage-usage | verb-list-databases | verb-list-tables
                    | verb-describe-table | verb-new-db | verb-export-db | verb-import-db
                    | verb-drop-db | verb-new-table | verb-flush-table | verb-drop-table
                    | verb-insert | verb-select-rows | verb-select-columns | verb-extend-table
                    | verb-list-columns | verb-list-headings | verb-update-rows
                    | verb-update-row | verb-delete-rows | verb-delete-row | verb-count-rows
                    | verb-group-by | verb-join-select | verb-join-left-select | verb-add
                    | verb-subtract | verb-multiply | verb-divide | verb-modulo | verb-raise
                    | verb-square-root-of | verb-logarithm-of | verb-fibonacci-of
                    | verb-factorial-of | verb-prime-of | verb-absolute-value-of | verb-round-of
                    | verb-floor-of | verb-ceiling-of | verb-compute | verb-new-date-and-time
                    | verb-new-date | verb-new-time | verb-get | verb-format-date-and-time
                    | verb-format-date | verb-format-time | verb-convert-timezone
                    | verb-randomize-date-and-time | verb-randomize-date | verb-randomize-time
                    | verb-cast | verb-encode | verb-decode | verb-format-number | verb-parse
                    | verb-convert | verb-generate-hash-for | verb-generate-hash
                    | verb-generate-key | verb-generate-uuid | verb-encrypt | verb-decrypt
                    | verb-randomize | verb-randomize-int | verb-randomize-float
                    | verb-randomize-string | verb-header | header-bare | verb-status
                    | verb-redirect | verb-cookie-set | verb-cookie-get | verb-cookie-remove
                    | verb-start-session | verb-kill-session | fetch-statement | verb-crawl
                    | wait-for-statement | verb-remember | verb-recall | verb-forget
                    | verb-cache-store | verb-cache-get | verb-cache-remove | verb-include
