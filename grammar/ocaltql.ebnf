verb-mesh-import-part ::= expression | capture

/* MESH <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     EXTRUDE FACES [<faces>]
     DISTANCE <n>
     SUBDIVIDE LEVEL <n>
     SMOOTH
     EXPORT AS <fmt>
     MEASURE
     BONE <name>
     FROM <xyz>
     TO <xyz>
     PARENT <bone>
     SKIN TO <rig>
     WEIGHT PAINT <mode>
     WEIGHT PAINT AUTO
     SCULPT BRUSH <kind>
     AT <xyz>
     RADIUS <n>
     STRENGTH <n>
     BOOLEAN UNION
     BOOLEAN SUBTRACT
     BOOLEAN INTERSECT
     WITH <mesh>
     KEYFRAME <bone>
     ROTATION <xyz>
     LOCATION <xyz>
     AT FRAME <n>
     INTERPOLATE <kind>
     BETWEEN FRAME <n>
     AND <n>
   returns a value: capture it with SET ?var */
verb-mesh         ::= "MESH" verb-mesh-part*
verb-mesh-part    ::= expression | "EXTRUDE" "FACES" expression | "DISTANCE" expression
                    | "SUBDIVIDE" "LEVEL" expression | "SMOOTH" | "EXPORT" "AS" expression
                    | "MEASURE" | "BONE" expression | "FROM" vector | "TO" vector
                    | "PARENT" expression | "SKIN" "TO" expression | "WEIGHT" "PAINT" expression
                    | "WEIGHT" "PAINT" "AUTO" | "SCULPT" "BRUSH" expression | "AT" vector
                    | "RADIUS" expression | "STRENGTH" expression | "BOOLEAN" "UNION"
                    | "BOOLEAN" "SUBTRACT" | "BOOLEAN" "INTERSECT" | "WITH" expression
                    | "KEYFRAME" expression | "ROTATION" vector | "LOCATION" vector
                    | "AT" "FRAME" expression | "INTERPOLATE" expression
                    | "BETWEEN" "FRAME" expression | "AND" expression | capture

