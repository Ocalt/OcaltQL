verb-generate-uuid ::= "GENERATE" "UUID" verb-generate-uuid-part*
verb-generate-uuid-part ::= capture

/* ENCRYPT <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     WITH <key> [required]
     AS <algorithm> [required]
   returns a value: capture it with SET ?var */
verb-encrypt      ::= "ENCRYPT" verb-encrypt-part*
verb-encrypt-part ::= expression | "WITH" expression | "AS" name | capture

/* DECRYPT <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     WITH <key> [required]
     AS <algorithm> [required]
   returns a value: capture it with SET ?var */
verb-decrypt      ::= "DECRYPT" verb-decrypt-part*
verb-decrypt-part ::= expression | "WITH" expression | "AS" name | capture

/* RANDOMIZE
   modifiers, in any order, each once unless repeatable:
     FROM RANGE <start>
     TO <end>
     FROM STRING <charset>
     LENGTH <n>
     PLACES <n>
     AS <integer|decimal>
   returns a value: capture it with SET ?var */
verb-randomize    ::= "RANDOMIZE" verb-randomize-part*
verb-randomize-part ::= "FROM" "RANGE" expression | "TO" expression | "FROM" "STRING" expression
                      | "LENGTH" expression | "PLACES" expression | "AS" name | capture

/* RANDOMIZE INT
   modifiers, in any order, each once unless repeatable:
     FROM RANGE <start> [required]
     TO <end> [required]
   returns a value: capture it with SET ?var */
verb-randomize-int ::= "RANDOMIZE" "INT" verb-randomize-int-part*
verb-randomize-int-part ::= "FROM" "RANGE" expression | "TO" expression | capture

/* RANDOMIZE FLOAT
   modifiers, in any order, each once unless repeatable:
     FROM RANGE <start> [required]
     TO <end> [required]
   returns a value: capture it with SET ?var */
verb-randomize-float ::= "RANDOMIZE" "FLOAT" verb-randomize-float-part*
verb-randomize-float-part ::= "FROM" "RANGE" expression | "TO" expression | capture

/* RANDOMIZE STRING
   modifiers, in any order, each once unless repeatable:
     WITH LENGTH <n>  (also written: LENGTH) [required]
     POOL <characters>
     AS <charset>
   returns a value: capture it with SET ?var */
verb-randomize-string ::= "RANDOMIZE" "STRING" verb-randomize-string-part*
verb-randomize-string-part ::= ( "WITH" "LENGTH" | "LENGTH" ) expression | "POOL" expression
                             | "AS" name | capture

/* HEADER <operand>
