/* COOKIE SET <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     AS <value> [required]
     PATH <path>
     EXPIRES <n>
     DAYS  (also written: DAY, HOURS, HOUR, MINUTES, MINUTE)
     DOMAIN <domain>
     SECURE
     HTTPONLY
   returns nothing (no SET capture) */
verb-cookie-set   ::= "COOKIE" "SET" verb-cookie-set-part*
verb-cookie-set-part ::= expression | "AS" expression | "PATH" expression | "EXPIRES" expression
                       | ( "DAYS" | "DAY" | "HOURS" | "HOUR" | "MINUTES" | "MINUTE" )
                       | "DOMAIN" expression | "SECURE" | "HTTPONLY"

/* COOKIE GET <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-cookie-get   ::= "COOKIE" "GET" verb-cookie-get-part*
verb-cookie-get-part ::= expression | capture

