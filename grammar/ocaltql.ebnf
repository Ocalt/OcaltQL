verb-file-select  ::= "FILE" "SELECT" verb-file-select-part*
verb-file-select-part ::= value-list | capture

/* FILE SELECTION <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     COPY
     MOVE
     DELETE
     TO <path>
   returns nothing (no SET capture) */
verb-file-selection ::= "FILE" "SELECTION" verb-file-selection-part*
verb-file-selection-part ::= expression | "COPY" | "MOVE" | "DELETE" | "TO" expression

/* FETCH and CURL modifiers. */
fetch-part        ::= "IP" "ALIAS" expression | "METHOD" expression | "HEADER" expression
                    | "BODY" expression | "USER" "AGENT" expression | "IP" expression
                    | "PROXY" expression | "TIMEOUT" expression | ( "SECONDS" | "SECOND" )
                    | "INTO" expression | fetch-capture
header-part       ::= expression | "AS" expression
assign-material-part ::= expression | "TO" expression | capture

/* ---------- Tokens --------------------------------------------------------- */
/* STRING    "text", 'text' or `text`. The three quotes mean the same. A string
             may run over several lines. Inside " and ', \n \t \r and \\
             work. Backticks keep everything exactly as written; \` is the
             one escape, for a backtick inside.
   INTEGER   12        FLOAT   3.14
   VARIABLE  ?name     letters, digits and _ after the ?
   NAME      a word: letters, digits and _, not starting with a digit
   !GLOBAL   ! then a name; the name is not case sensitive
   Comments  (* like this *), over several lines if needed. They do not nest. */

STRING          ::= '"' ( [^"\] | '\' . )* '"' | "'" ( [^'\] | '\' . )* "'" | '`' ( [^`] | '\`' )* '`'
INTEGER         ::= [0-9]+
FLOAT           ::= [0-9]+ '.' [0-9]+
VARIABLE        ::= '?' [a-zA-Z0-9_]+
NAME            ::= [a-zA-Z_] [a-zA-Z0-9_]*
DEVICE-CHAR     ::= [^#x5B#x5D]   /* any character but [ and ] */
SOURCE-TOKEN    ::= ( STRING | INTEGER | FLOAT | VARIABLE | '!' NAME | NAME | [&+*/()%,#x5B#x5D-] )
                    - ( "SET" | "AND" | "OR" | "AFTER" )
PHRASE-WORD     ::= NAME - ( "SET" | "AND" | "OR" | "AFTER" | "OPEN" | "CLOSE" )
