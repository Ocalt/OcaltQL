     VIA COORDINATES <s>  (also written: VIA COORDS)
     VIA <place>
     COUNTRY <cc>
     PROVINCE <name>  (also written: STATE)
     PROFILE <type>  (also written: MODE)
     ALTERNATIVES
   returns a value: capture it with SET ?var */
verb-map-route    ::= "MAP" "ROUTE" verb-map-route-part*
verb-map-route-part ::= ( "FROM" "COORDINATES" | "FROM" "COORDS" ) expression
                      | "FROM" expression | ( "TO" "COORDINATES" | "TO" "COORDS" ) expression
                      | "TO" expression | ( "VIA" "COORDINATES" | "VIA" "COORDS" ) expression
                      | "VIA" expression | "COUNTRY" expression
                      | ( "PROVINCE" | "STATE" ) expression | ( "PROFILE" | "MODE" ) expression
                      | "ALTERNATIVES" | capture

