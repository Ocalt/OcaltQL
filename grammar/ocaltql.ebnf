verb-sim-results-open-part ::= expression | capture

/* SIM <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     CONTOUR PLOT <field>
     SCALE <colours>
     ASSIGN MATERIAL <m>
     FIXED SUPPORT ON FACE <f>
     FORCE <xyz>
     ON FACE <f>
     SOLVE
     SAFETY FACTOR
     EXTRACT STRESS <kind>
     EXTRACT DISPLACEMENT
     SAVE INTO <path>
     REFINE REGION <face>
     FACTOR <n>
     ASSIGN FLUID <fluid>
     VELOCITY INLET <xyz>
     PRESSURE OUTLET <Pa>
     NO SLIP WALL
     INITIAL VELOCITY <xyz>
     CONTACT BETWEEN <face>
     AND <face>
     FRICTION <n>
     EXTRACT CONCENTRATION <name>
     EXTRACT DRAG FORCE
     EXTRACT STREAMLINES
     EXTRACT PLASTIC STRAIN
     EXTRACT ENERGY <kind>
     HISTORY
   returns a value: capture it with SET ?var */
verb-sim          ::= "SIM" verb-sim-part*
verb-sim-part     ::= expression | "CONTOUR" "PLOT" expression | "SCALE" expression
                    | "ASSIGN" "MATERIAL" expression | "FIXED" "SUPPORT" "ON" "FACE" vector
                    | "FORCE" vector | "ON" "FACE" vector | "SOLVE" | "SAFETY" "FACTOR"
                    | "EXTRACT" "STRESS" expression | "EXTRACT" "DISPLACEMENT"
                    | "SAVE" "INTO" expression | "REFINE" "REGION" expression
                    | "FACTOR" expression | "ASSIGN" "FLUID" expression
                    | "VELOCITY" "INLET" vector | "PRESSURE" "OUTLET" expression
                    | "NO" "SLIP" "WALL" | "INITIAL" "VELOCITY" vector
                    | "CONTACT" "BETWEEN" expression | "AND" expression | "FRICTION" expression
                    | "EXTRACT" "CONCENTRATION" expression | "EXTRACT" "DRAG" "FORCE"
                    | "EXTRACT" "STREAMLINES" | "EXTRACT" "PLASTIC" "STRAIN"
                    | "EXTRACT" "ENERGY" expression | "HISTORY" | capture

