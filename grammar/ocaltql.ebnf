/* SCENE <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     LIGHT <kind>
     RENDER
     RENDER ANIMATION
     RENDER WALKTHROUGH
     RENDER PANORAMA
     FRAMES <n>
     TO <n>
     PATH [<points>]
     DURATION <s>
     PLACE <object>
     AT <xyz>
     ROTATION <xyz>
     CAMERA AT <xyz>
     LOOKAT <xyz>
     FOV <deg>
     SAVE INTO <path>
     SAVE
     LIST
     SUN
     DIRECTION <xyz>
     INTENSITY <n>
     RENDER INTO <path>
     RESOLUTION <w,h>
     SKY HDRI <file>
     SAMPLES <n>
     WIDTH <px>
     HEIGHT <px>
   returns a value: capture it with SET ?var */
