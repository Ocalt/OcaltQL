/* ONBROWSER JAVASCRIPT <operand>
   operand optional (value)
   modifiers, in any order, each once unless repeatable:
     EVENT  (also written: ONLOADED, ONCLICK, ONDBLCLICK, ONFOCUS, ONBLUR, ONCHANGE, ONINPUT, ONSUBMIT, ONKEYDOWN, ONKEYUP, ONKEYPRESS, ONMOUSEOVER, ONMOUSEOUT, ONMOUSEDOWN, ONMOUSEUP, ONMOUSEMOVE, ONSCROLL, ONRESIZE, ONPAGESHOW, ONPAGEHIDE, ONCONTEXTMENU, ONREADY, ONERROR, ONTOUCHSTART, ONTOUCHEND) [required]
     ENTER <code> [required]
   returns nothing (no SET capture) */
verb-onbrowser-javascript ::= "ONBROWSER" "JAVASCRIPT" verb-onbrowser-javascript-part*
