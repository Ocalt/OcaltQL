                                 | ( "ONLOAD" | "ONLOADED" | "ONCLICK" | "ONDBLCLICK" | "ONFOCUS" | "ONBLUR" | "ONCHANGE" | "ONINPUT" | "ONSUBMIT" | "ONKEYDOWN" | "ONKEYUP" | "ONKEYPRESS" | "ONMOUSEOVER" | "ONMOUSEOUT" | "ONMOUSEDOWN" | "ONMOUSEUP" | "ONMOUSEMOVE" | "ONSCROLL" | "ONRESIZE" | "ONPAGESHOW" | "ONPAGEHIDE" | "ONCONTEXTMENU" | "ONREADY" | "ONERROR" | "ONTOUCHSTART" | "ONTOUCHEND" )
                                 | "ENTER" expression

