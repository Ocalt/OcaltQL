                    | verb-directive-unregister | verb-directive-register | verb-directive-list
                    | verb-directive-view-end | verb-directive-serve-end
                    | verb-directive-tunnel-end | verb-directive-status | class-def | verb-spawn
                    | verb-call | query-def | query-statement | verb-new-cad-sketch
                    | verb-cad-extrude | verb-cad-revolve | verb-cad-loft | verb-new-cad-box
                    | verb-cad-sweep | verb-cad-fillet | verb-cad-shell | verb-cad-pattern
                    | verb-cad-pattern-linear | verb-cad-interference-check | verb-cad-mirror
                    | verb-cad-boolean | verb-cad-tessellate | verb-cad-import
                    | verb-cad-boolean-union | verb-cad-boolean-subtract
                    | verb-cad-boolean-intersect | verb-bim-import | verb-pcb-import
                    | verb-timeline-open | verb-presentation-open | verb-new-font
                    | verb-font-update | verb-new-editor | verb-graph-open | verb-cad-export
                    | verb-cad | verb-new-chat | verb-chat | verb-chat-peer-list
                    | verb-chat-list | verb-account-login | verb-account-register
                    | verb-account-verify | verb-account-update-email
                    | verb-account-update-password | verb-account-delete | verb-account-compare
                    | verb-account-revoke | verb-domain | verb-domain-status
                    | verb-domain-remove | verb-domain-ssl | convert-media | verb-parse-json
                    | verb-parse-csv | verb-parse-oqlobject | verb-new-scene | verb-scene-open
                    | verb-scene-import | verb-scene | verb-new-material | verb-material-open
                    | verb-material | verb-assign-material | assign-material-subject-first
                    | verb-sim-mesh | verb-new-sim-material | verb-new-sim-fluid
                    | verb-new-sim-study | verb-sim-open | verb-sim-results-open | verb-sim
                    | verb-new-mesh-armature | verb-new-mesh-animation | verb-new-mesh-primitive
                    | verb-mesh-import | verb-mesh | verb-qr | editor-statement
                    | verb-file-select | file-select-all | verb-file-selection

/* A block holds a sequence. An empty block is allowed. */
block             ::= "OPEN" sequence? "CLOSE"

/* The block of an IF, WHILE, LOOP or any block verb may be followed by
     OR IF ... OPEN ... CLOSE (else-if) and a final OR OPEN ... CLOSE (else).
     There is no ELSE keyword. */
/* "SET ?img AS OPEN": an AS straight before the block is allowed and means nothing. */
block-part        ::= "AS"? block-cascade

block-cascade     ::= block ( "OR" "IF" condition block )* ( "OR" block )?

/* Capturing a verb's result. Only verbs that return a value take these.
     SET PROMISE starts the work and moves on at once; the variable is
     WAITING until the work finishes. SET PERSISTENT keeps the value for the
     session (five minutes). SET CONSISTENT writes it to a named store that
     outlives the script. */
capture           ::= "SET" ( VARIABLE | "PROMISE" VARIABLE | "PERSISTENT" VARIABLE |
                      "CONSISTENT" STRING | writable-global )

/* On a verb whose own modifier starts with SET (UPDATE ROWS ... SET "col" AS v),
     SET followed by a global is read as that modifier, so the capture is one of these. */
capture-var       ::= "SET" ( VARIABLE | "PROMISE" VARIABLE | "PERSISTENT" VARIABLE |
                      "CONSISTENT" STRING )

/* The verbs with a shape of their own capture with a plain variable. */
set-var           ::= "SET" VARIABLE

/* ---------- Values -------------------------------------------------------- */
/* & joins text and binds loosest; then + and -; then * and /. */
expression        ::= sum ( "&" sum )*

sum               ::= product ( "FIRST" "DAY" | "LAST" "DAY" )
                    | product ( "+" product time-unit? | "-" product ( time-unit | "AS" time-unit )? )*

/* ?date + 1 DAY moves a date. ?a - ?b AS DAYS is the gap between two dates.
     ?date FIRST DAY / LAST DAY is the first or last day of its month. */
time-unit         ::= "DAY" | "DAYS" | "WEEK" | "WEEKS" | "MONTH" | "MONTHS" | "YEAR" | "YEARS"
                    | "HOUR" | "HOURS" | "MINUTE" | "MINUTES" | "SECOND" | "SECONDS"

product           ::= unary ( ( "*" | "/" ) unary )*

unary             ::= "-" unary | of-chain

/* "city" OF "address" OF ?user is the same as ?user("address")("city").
     Read it right to left. A bare keyed global can stand at the end:
     "token" OF !SESSION, "key" OF "category" OF !GLOBALS. */
of-chain          ::= atom ( "OF" atom )* ( "OF" keyed-global-name )?

atom              ::= STRING | number "%"? | VARIABLE index* | "THIS" index* | "TRUE" | "FALSE"
                    | "NULL" | "PERSISTENT" VARIABLE index*
                    | "COUNT" ( VARIABLE index* | "(" expression ")" | bracket-value index* )
                    | function-call | "(" expression ")" | bracket-value index* | global-value

number            ::= INTEGER | FLOAT

/* ?x("key"), ?list(0), ?x("a")("b"). A ( straight after a value is
     always an index, never a group. */
index             ::= "(" expression ")"

function-call     ::= ( "ABS" | "ROUND" | "FLOOR" | "CEIL" | "SQRT" | "POWER" | "MOD" ) "("
                      expression ( "," expression )* ")"

/* [ ... ] is one of four things, told apart by what is inside:
       []                        an empty array
       [VERB ...]                an inline statement; it runs first and its
                                 result is the value
       ["k" AS v AND "k2" AS w]  an object
       [a AND b AND c]           an array */
bracket-value     ::= "[" "]" | "[" statement "]"
                    | "[" expression "AS" literal-value ( "AND" expression "AS" literal-value )* "]"
                    | "[" expression ( "AND" literal-value )* "]"

/* Inside a literal a value may also be a statement written without
     brackets, which is how objects store nested objects:
     ["user" AS NEW OBJECT ["name" AS "Kea"]] */
literal-value     ::= statement | expression

global-value      ::= "!THAT" index* | ( "!NOW" | "!IP" | "!UA" | "!QUERY" | "!VALUE" ) index*
                    | ( "!THIS" | "!ERROR" ) "(" STRING ")" index*
                    | keyed-global-name ( "(" expression ")" )+

keyed-global-name ::= "!GLOBAL" | "!GLOBALS" | "!GET" | "!POST" | "!REQUEST" | "!SERVER"
                    | "!ENV" | "!FILES" | "!SESSION" | "!COOKIE"

/* Globals that can be written to: SET !GLOBAL('k') AS ..., ... SET !COOKIE('k').
     !GLOBALS takes two keys: !GLOBALS('category')('key'). */
writable-global   ::= ( "!GLOBAL" | "!GET" | "!POST" | "!COOKIE" | "!SESSION" | "!HEADER" ) "(" STRING ")"
                    | "!GLOBALS" "(" STRING ")" "(" STRING ")"

/* What SET, UNSET and other writing verbs write to. */
target            ::= VARIABLE ( "(" expression ( "," expression )* ")" )* | "THIS" index+
                    | STRING ( "OF" atom )* "OF" ( VARIABLE | "THIS" ) index* | writable-global

/* A bare name: an operation, class, format or algorithm name. A name
     written without spaces may contain hyphens: hmac-sha256, aes-256.
     QUERY STRING and DATE AND TIME are read as one name. */
name              ::= NAME ( "-" ( NAME | INTEGER ) )* | "QUERY" "STRING" | "DATE" "AND" "TIME"

/* A target format: TO PDF, TO "pdf", TO 3GP. */
format-word       ::= STRING | NAME | INTEGER NAME?

/* ---------- Conditions (IF, WHILE, OR IF) ---------------------------------- */
/* AND binds tighter than OR. Evaluation is left to right and stops as soon
     as the answer is known. An OR followed by IF or OPEN is not part of the
     condition: it starts the else-if or else of the IF. */
condition         ::= condition-and ( "OR" condition-and )*

condition-and     ::= comparison ( "AND" comparison )*

/* A bare value is tested for truth: IF ?ok OPEN ... CLOSE.
     IS and ARE mean the same for one value. ?list ARE ... is true only when
     every element passes; SOME ?list ARE ... when at least one does. */
comparison        ::= "SOME"? expression ( "CONTAINS" expression ( ( "IS" | "ARE" ) "NOT"? (
                      "TRUE" | "FALSE" ) )? | ( "IS" | "ARE" ) "NOT"? comparison-test )?

comparison-test   ::= "EQUAL" "TO" expression | "IDENTICAL" "TO" expression
                    | "GREATER" "THAN" ( "OR" "EQUAL" "TO" )? expression
                    | "LESS" "THAN" ( "OR" "EQUAL" "TO" )? expression | "WAITING" | "SET"
                    | "EMPTY" | "NULL" | "TRUE" | "FALSE" | "ARRAY" | "OBJECT" | "NUMBER"
                    | "STRING" | "BOOLEAN"

/* ---------- Database clauses -------------------------------------------- */
/* WHERE "age" IS GREATER THAN 18 AND "city" IS EQUAL TO "Durban".
     AND continues the WHERE only when a column ("name" or ?var) follows it;
     otherwise it chains the next statement. "id" OF "users" names a column
     of another table, for joins. */
where-clause      ::= where-and ( "OR" where-and )*

where-and         ::= where-test ( "AND" where-column-test )*

where-test        ::= atom where-rest

where-column-test ::= ( STRING | VARIABLE index* ) where-rest

where-rest        ::= ( "OF" atom )? ( "CONTAINS" atom | ( "IS" | "ARE" ) "NOT"? where-op )

where-op          ::= ( "EQUAL" | "IDENTICAL" ) "TO" atom ( "OF" atom )?
                    | ( "GREATER" | "LESS" ) "THAN" ( "OR" "EQUAL" "TO" )? atom
                    | ( "PREFIX" | "SUFFIX" )? "SIMILAR" "TO" atom | "NULL" | "EMPTY" | "TRUE"
                    | "FALSE"

/* COLUMNS ADD "id" TYPE NUMBER AUTOINCREMENT PRIMARY AND ADD "name" TYPE STRING
     Each column needs exactly one TYPE; its other words go in any order. */
column-list       ::= column-def ( "AND" column-def )*

column-def        ::= "ADD" atom column-word* "TYPE" ( "STRING" | "NUMBER" | "DATE" | "BOOL" )
                      column-word*

column-word       ::= "LENGTH" atom | "DEFAULT" atom | "HEADING" atom | "SOURCE" "TYPE" atom
                    | "PRIMARY" | "AUTOINCREMENT" | "UNIQUE" | "REQUIRED" | "AUTOTIMESTAMP"
                    | "AUTOUPDATED"

/* "name" AS "Kea" AND "age" AS 30 */
pairs             ::= pair ( "AND" pair )*

pair              ::= expression "AS" expression

/* "a.txt" AND "b.txt" AND ?more */
value-list        ::= expression ( "AND" expression )*

/* An X or Y that also takes a percentage or a position word. */
coordinate        ::= "TOP" | "BOTTOM" | "LEFT" | "RIGHT" | "CENTRE" | "CENTER" | number "%"
                    | expression

/* A 3D position or direction: AT 10,5,2. Commas appear only here and
     inside function calls. */
vector            ::= expression ( "," expression )*

/* ONDEVICE [CAMERA REAR CAPTURE]: the text between the brackets is the
     device's own command language and is passed on exactly as written. */
device-command    ::= "[" device-text "]"

device-text       ::= ( DEVICE-CHAR | "[" device-text "]" )*

/* BIND ["m" AS ?msg AND "p" AS "/x"] */
bracket-pairs     ::= "[" ( pair ( "AND" pair )* )? "]"

/* NEW EVENT ... THEN <action>: the action is kept exactly as written and
     run when the event fires. It takes every token up to the next SET, AND,
     OR or AFTER, so put THEN last, or just before SET. */
scheduled-action  ::= SOURCE-TOKEN+

/* ======================================================================
   Verbs with a shape of their own. Every other verb follows the general
   shape: its words, then its operand, modifiers, capture and block in
   any order (see the generated rules below).
   ====================================================================== */
/* ---------- Variables -------------------------------------------------- */
/* SET "key" AS value OF !SESSION writes one key of a writable global. */
set-into-global   ::= "SET" STRING "AS" atom "OF" ( "!GLOBAL" | "!POST" | "!GET" | "!COOKIE" |
                      "!SESSION" | "!HEADER" )

/* FOREACH ?list SET ?item OPEN ... CLOSE, or SET ?key AS ?value for objects. */
foreach-statement ::= "FOREACH" expression "SET" VARIABLE ( "AS" VARIABLE )? block

/* SWITCH ?x OPEN CASE 1 CASE 2 ... BREAK DEFAULT ... CLOSE.
     Without BREAK a case falls through into the next one. */
switch-statement  ::= "SWITCH" expression "OPEN" switch-arm* "CLOSE"

/* Inside a case, statements are joined with AFTER, and BREAK comes first or
     after an AFTER: CASE 1 EMIT "one" AFTER BREAK. */
switch-arm        ::= ( ( "CASE" expression )+ | "DEFAULT" ) switch-body?

switch-body       ::= "BREAK" | or-chain ( "AFTER" or-chain )* ( "AFTER" "BREAK"? )?

/* CATCH ERROR SET ?err, or CATCH ERROR OPEN ... CLOSE. */
catch-statement   ::= "CATCH" "ERROR" ( capture | block )*

/* WAIT FOR ?promise, with an optional timeout in seconds. */
/* The timeout starts with a number or a ?variable. */
wait-for-statement ::= "WAIT" "FOR" expression ( ( number | VARIABLE index* ) expression-tail? (
                       "SECONDS" | "SECOND" ) )? set-var?

/* The rest of a value whose first part is already written. */
expression-tail   ::= ( "OF" atom | ( "*" | "/" ) unary | ( "+" | "-" ) product | "&" sum )+

/* SEND ?socket "message" */
send-statement    ::= "SEND" expression expression

/* HEADER JSON, HEADER STATUS AS 404, HEADER "X-Name" AS "v" */
header-bare       ::= "HEADER" NAME header-part*

/* ---------- Operations and classes ---------------------------------------- */
/* NEW OPERATION greet WITH ?name AS STRING REQUIRED AND ?n AS NUMBER DEFAULT 1 OPEN ... CLOSE
     Operations are defined at the top level, never inside another operation. */
operation-def     ::= "NEW" "PERSISTENT"? "OPERATION" NAME ( "WITH" parameter ( "AND" parameter
                      )* )? block

parameter         ::= VARIABLE ( "AS" ( "STRING" | "NUMBER" | "BOOL" | "DATE" ) ( "REQUIRED" |
                      "DEFAULT" expression )? )?

/* RUN greet WITH "Kea" AND 2 SET ?r */
run-statement     ::= "RUN" "PERSISTENT"? NAME ( "WITH" expression ( "AND" expression )* )?
                      set-var?

/* NEW CLASS Dog EXTENDS Animal WITH "name" AS STRING REQUIRED AND "bark" AS METHOD OPEN ... CLOSE */
class-def         ::= "NEW" "CLASS" NAME ( "EXTENDS" NAME )? ( "WITH" class-property ( "AND"
                      class-property )* )?

class-property    ::= STRING "AS" ( "METHOD" block | ( "STRING" | "NUMBER" | "BOOL" | "DATE" ) (
                      "REQUIRED" | "DEFAULT" atom )* )

/* ?mesh ASSIGN MATERIAL ?m: the object may come first. */
assign-material-subject-first ::= VARIABLE "ASSIGN" "MATERIAL" ( expression capture? | capture
                                  expression )

/* ---------- Custom queries ------------------------------------------------ */
/* NEW QUERY AS OPEN STEP "add" NEXT STEP VALUE NUMBER ... END CLOSE */
query-def         ::= "NEW" "PERSISTENT"? "QUERY" ( "CASE" STRING | "SEPARATOR" STRING )* "AS"?
                      "OPEN" query-steps "CLOSE"

query-steps       ::= query-step ( "FALLBACK" query-step-plain )? ( "NEXT" query-step (
                      "FALLBACK" query-step-plain )? )* "END"

/* ?verb STEP: the word typed at this step is put into ?verb. */
query-step        ::= VARIABLE "STEP" "SKIPPABLE"? sequence? | query-step-plain

query-step-plain  ::= "STEP" ( "VALUE" ( "NUMBER" | "STRING" )? ( "MIN" number )? ( "MAX" number
                      )? ( "EXCEPT" STRING ( "AND" STRING )* )? | STRING ( "OR" "STEP" STRING )*
                      ) "SKIPPABLE"? sequence?

/* QUERY add one to 41, or QUERY ?phrase, or QUERY "stores" FROM "shop". */
/* When the phrase starts with a ?variable or "string" it is a value: the
     phrase to look up. Otherwise the words themselves are the phrase. */
query-statement   ::= "QUERY" ( ( VARIABLE index* | STRING ) expression-tail? ( "FROM"
                      expression | "SET" VARIABLE )* | ( PHRASE-WORD | number | "SET" )
                      phrase-item* set-var? )

/* A phrase is words, strings, numbers and ?variables. A ?variable gives its
     value at that position. SET ends the phrase only when a ?variable follows it
     and nothing else of the phrase does (QUERY add one to 41 SET ?r); otherwise
     it is a word, as in QUERY set optionB. */
phrase-item       ::= PHRASE-WORD | STRING | number | VARIABLE | "SET"

/* ---------- Web requests -------------------------------------------------- */
/* FETCH "https://..." METHOD "POST" BODY ?b SET ?r WITH STATUS AND SET ?d WITH DATA */
fetch-statement   ::= ( "FETCH" | "CURL" ) expression fetch-part*

fetch-capture     ::= "SET" "PROMISE" VARIABLE
                    | "SET" VARIABLE ( "WITH" "STATUS" | "WITH" "DATA" | "AND" "SET" VARIABLE )*

/* ---------- Charts --------------------------------------------------------- */
/* GRAPH TYPE "bar" WITH ?data TITLE "Sales" FORMAT 800 BY 400 AXIS X "Month" AND Y "Rand" SET ?svg */
graph-statement   ::= "GRAPH" "TYPE" expression graph-part* set-var?

graph-part        ::= "SET" VARIABLE | "WITH" expression | "TITLE" expression
                    | "THEME" expression | "FORMAT" sum "BY" sum
                    | "AXIS" axis-label ( "AND" axis-label )*

axis-label        ::= ( "X" | "Y" | "Z" ) expression

/* ---------- Conversion ---------------------------------------------------- */
/* CONVERT IMAGE ?file TO jpg AS "/root/out.jpg" SET ?r. TO takes a format, AS
     the file to write. Both go in any order; TO is required. */
convert-media     ::= "CONVERT" ( "AUDIO" | "VIDEO" | "DOCUMENT" | "IMAGE" ) expression
                      convert-part* "TO" format-word convert-part*

convert-part      ::= "AS" expression | "SET" "PROMISE"? VARIABLE

file-select-all   ::= "FILE" "SELECT" "ALL" expression set-var?

/* ---------- Rich documents ------------------------------------------------ */
/* RICH INSERT "text" FONT "Inter" SIZE 12 AT LINE 3 SET ?doc */
rich-statement    ::= "RICH" ( "PAGE" "NUMBER" | NAME ) expression rich-part* set-var?

rich-part         ::= "MARGIN" ( ( "TOP" | "BOTTOM" | "LEFT" | "RIGHT" ) sum )*
                    | "AT" ( "LINE" sum | sum "BY" sum )
                    | "FROM" "LINE" sum ( "COL" sum )? ( "TO" "LINE" sum ( "COL" sum )? )?
                    | "FROM" sum "BY" sum ( "TO" sum "BY" sum )? | "LINE" "HEIGHT" sum
                    | "COL" sum
                    | ( "SIZE" | "ORIENTATION" | "WITH" | "AS" | "INTO" | "POSITION" | "FONT" | "WEIGHT" | "COLOR" | "COLOUR" | "WIDTH" | "HEIGHT" | "ALIGN" | "ITALIC" | "UNDERLINE" | "STRIKETHROUGH" | "LINK" | "TYPE" | "ELEMENT" | "TO" ) sum

/* ---------- HTML ----------------------------------------------------------- */
/* Inside an HTML block, statements follow one another without AFTER. */
html-block        ::= "OPEN" sequence* "CLOSE"

new-html          ::= "NEW" "HTML" "NODE"? ( set-var html-block? | html-block set-var? )?

html-element      ::= "HTML" expression ( "AND"? ( "ATTR" expression "WITH" expression | "TEXT"
                      expression | "SRC" expression ) )* ( set-var html-block? | html-block
                      set-var? )?

html-append       ::= "HTML" "APPEND" expression ( "TO" VARIABLE | "INTO" VARIABLE "WHERE" (
                      "ID" | "TAG" ) expression )

html-text-node    ::= "HTML" "TEXT" "NODE" expression ( "SET" VARIABLE )?

/* ---------- Presentations --------------------------------------------- */
new-presentation  ::= "NEW" "PRESENTATION" ( "INTO" expression | "SET" VARIABLE )* "AS" "OPEN" (
                      "SLIDE" slide )* "CLOSE"

slide             ::= "LAYOUT" expression slide-rest

slide-rest        ::= ( "DURATION" expression | "TRANSITION" expression ( "DURATION" expression
                      )? )* "OPEN" slide-element* "CLOSE"

slide-element     ::= ( ( "TITLE" | "SUBTITLE" | "BODY" | "IMAGE" | "VIDEO" | "NOTE" |
                      "BACKGROUND" | "THEME" | "COLOR" | "COLOUR" ) expression | "FONT"
                      expression ( "SIZE" sum )? | "TABLE" "WITH" expression | "GRAPH" "TYPE"
                      expression ( "WITH" expression )? | "BULLET" "OPEN" ( "ITEM" expression
                      animation* )* "CLOSE" ) placement* animation*

/* AT x BY y places the element, FORMAT w BY h sizes it, both in percent of the slide. */
placement         ::= "AT" sum "BY" sum | "FORMAT" sum "BY" sum
                    | "ALIGN" ( "LEFT" | "CENTER" | "CENTRE" | "RIGHT" ) ( "TOP" | "MIDDLE" | "BOTTOM" )

animation         ::= "ANIMATE" ( "ENTER" | "EXIT" | "EMPHASIS" ) expression ( "DELAY"
                      expression | "DURATION" expression )*

presentation-statement ::= "PRESENTATION" expression ( "SLIDE" ( "COUNT" | sum ( "REPLACE" slide
                           | "MOVE" "TO" sum | "DELETE" | "EXPORT" "AS" format-word ) ) | "SAVE"
                           ( "INTO" expression )? | "ADD" "SLIDE" "LAYOUT" expression ( "AT" sum
                           )? slide-rest | "EXPORT" "AS" format-word ) set-var?

/* ---------- Audio and video ------------------------------------------------- */
media-statement   ::= "MEDIA" expression media-op set-var?

media-op          ::= "PROBE" ( "VIDEO" | "AUDIO" )?
                    | ( "EXPORT" | "TRANSCODE" ) "AS" format-word
                    | "SCALE" ( "WIDTH" expression )? ( "HEIGHT" expression )?
                    | "SPEED" ( "RAMP" "FROM" expression "TO" expression "RATE" expression | expression )
                    | "TRIM" "FROM" expression "TO" expression | "SPLICE" "WITH" expression
                    | "EXTRACT" ( "FRAME" "AT" expression | "AUDIO" )
                    | "INSERT" "FRAME" expression "AT" expression "DURATION" expression
                    | "INSERT" "CLIP" expression "AT" expression "DURATION" expression "LOOP"?
                    | "REPLACE" ( "FRAME" | "CLIP" ) "WITH" expression "FROM" expression "TO" expression
                    | "REPLACE" "AUDIO" "WITH" expression | "MUTE" | "NORMALIZE" | "REVERSE"
                    | "STABILIZE" | "BOOMERANG" | "VOLUME" expression | "PITCH" expression
                    | "MIX" "WITH" expression
                    | "FADE" ( "IN" | "OUT" ) "DURATION" expression "FROM" expression
                    | "OVERLAY" expression "AT" "X" expression "Y" expression
                    | "SUBTITLE" "WITH" expression
                    | "TEXT" expression ( "POSITION" "X" place "Y" place | "SIZE" expression | "COLOR" expression | "FONT" expression )*
                    | "BLUR" "RADIUS" expression
                    | "COLOR" "GRADE" ( ( "CONTRAST" | "SATURATION" | "BRIGHTNESS" | "GAMMA" ) expression )*
                    | "MIRROR" ( "HORIZONTAL" | "VERTICAL" )
                    | "FREEZE" "FRAME" "AT" expression "DURATION" expression
                    | "LOOP" "TIMES" expression
                    | "GREEN" "SCREEN" "WITH" expression ( ( "KEY" | "SIMILARITY" | "BLEND" ) expression )*
                    | "SPLIT" "SCREEN" "WITH" expression ( "HORIZONTAL" | "VERTICAL" )?
                    | "TRANSITION" "WITH" expression "DURATION" expression
                    | "AUTO" "CAPTION" ( ( "LANGUAGE" | "STYLE" | "COLOR" ) expression | "POSITION" "Y" place )*

place             ::= "CENTRE" | "CENTER" | "MIDDLE" | "LEFT" | "RIGHT" | "TOP" | "BOTTOM"
                    | expression

timeline-statement ::= "TIMELINE" expression ( "SAVE" ( "INTO" expression )? | "ADD" "TRACK"
                       expression | "TRACK" expression "PLACE" expression "AT" expression |
                       "RENDER" ) set-var?

/* ---------- Images ----------------------------------------------------- */
graphic-statement ::= "GRAPHIC" expression graphic-op set-var?

graphic-op        ::= "RESIZE" ( "WIDTH" expression )? ( "HEIGHT" expression )?
                    | "CROP" "POSITION" "X" coordinate "Y" coordinate "WIDTH" expression "HEIGHT" expression
                    | "ROTATE" expression | "FLIP" ( "HORIZONTAL" | "VERTICAL" )
                    | "THUMBNAIL" "WIDTH" expression "HEIGHT" expression
                    | "FILTER" ( expression )? "AS" ( NAME | STRING )
                    | "REPLACE" expression "WITH" expression
                    | "FILL" "X" coordinate "Y" coordinate "WITH" expression
                    | "GET" "COLOR" "OF" "X" coordinate "Y" coordinate
                    | "SELECT" ( ( "RECTANGLE" | "ELLIPSE" ) "X" coordinate "Y" coordinate "WIDTH" expression "HEIGHT" expression | "LASSO" "POINTS" expression | "COLOR" expression ( "TOLERANCE" expression )? )
                    | ( "CUT" | "COPY" ) expression ( "TO" VARIABLE )? | "DELETE" expression
                    | "MOVE" expression "X" coordinate "Y" coordinate
                    | "PASTE" expression "AT" "X" coordinate "Y" coordinate
                    | "TEXT" expression ( "AND"? ( "POSITION" "X" coordinate "Y" coordinate | ( "FONT" | "SIZE" | "COLOR" | "WEIGHT" | "OUTLINE" | "SHADOW" | "BACKGROUND" ) expression ) )*
                    | "WATERMARK" "WITH" expression
                    | "COMPOSITE" "WITH" expression "AT" "X" coordinate "Y" coordinate
                    | "REMOVE" "BACKGROUND" | "HISTOGRAM"
                    | "ADD" ( "LAYER" | "IMAGE" ) expression
                    | "ORDER" ( "ABOVE" | "BELOW" ) expression | "OPACITY" expression
                    | "BLEND" expression | "HIDE" | "SHOW" | "FLATTEN"
                    | "EXPORT" "AS" expression

/* ---------- Text and code editor -------------------------------------------- */
/* Lines and columns count from 1. */
editor-statement  ::= "EDITOR" ( "OPEN" expression | expression editor-op ) set-var?

editor-op         ::= "SAVE" ( "INTO" expression )? | "LANG"
                    | "GOTO" "LINE" expression "COL" expression
                    | "SELECT" ( range | "LINE" expression | "ALL" | "BLOCK" range )
                    | "SELECTION" expression ( "COPY" | "DELETE" | "CUT" | "INDENT" | "OUTDENT" | "UPPERCASE" | "LOWERCASE" | "REPLACE" "WITH" expression )
                    | "PASTE" "AT" expression | "INSERT" "AT" expression "WITH" expression
                    | "DELETE" ( "AT" expression | "LINE" expression | "FROM" "LINE" expression "TO" "LINE" expression )
                    | "BACKSPACE" "AT" expression
                    | "REPLACE" ( "LINE" expression "WITH" expression | range "WITH" expression | ( "ALL" | "FIRST" ) "REGEX"? expression "WITH" expression )
                    | "EXTRACT" ( "LINE" expression | "BLOCK" range | range )
                    | "FIND" "REGEX"? "WITH" expression
                    | ( "DUPLICATE" | "JOIN" | "INDENT" | "OUTDENT" ) "LINE" expression
                    | "MOVE" "LINE" expression ( "UP" | "DOWN" )
                    | ( "SORT" | "DEDUPLICATE" ) "LINES" | "TRIM" "TRAILING" "WHITESPACE"
                    | "CONVERT" ( "LINE" "ENDINGS" "TO" expression | "TABS" "TO" "SPACES" | "SPACES" "TO" "TABS" | "ENCODING" "TO" expression )
                    | "BOOKMARK" "REMOVE"? "LINE" expression | "BOOKMARKS"
                    | "COUNT" ( "LINES" | "WORDS" | "CHARS" )

range             ::= "FROM" "LINE" expression "COL" expression "TO" "LINE" expression "COL"
                      expression

/* ---------- FTP, email, browser, sync channels -------------------------------- */
ftp-statement     ::= "FTP" expression ftp-op ( "SET" "PROMISE"? VARIABLE )?

ftp-op            ::= ( "LIST" | "STAT" | "SPACE" | "MKDIR" | "DELETE" ) expression | "CLOSE"
                    | "UPLOAD" expression "TO" expression
                    | "DOWNLOAD" expression "INTO" expression
                    | "MOVE" expression "TO" expression
                    | "TRANSFER" expression "TO" expression expression

email-statement   ::= "EMAIL" expression email-op ( "SET" "PROMISE"? VARIABLE )?

email-op          ::= "LIST" "FOLDERS"? | "INBOX" | "SENT" | "DRAFTS" | "SPAM" | "TRASH"
                    | "UNREAD" | "CLOSE" | "FOLDER" expression ( "SEARCH" expression )?
                    | ( "SEARCH" | "UID" | "LABELS" | "DELETE" ) expression
                    | "MARK" expression "AS" ( "READ" | "UNREAD" | "FLAGGED" | "UNFLAGGED" | "DELETED" )
                    | ( "MOVE" | "COPY" ) expression "TO" expression
                    | ( "ADD" | "REMOVE" ) "LABEL" expression "AS" expression
                    | "SAVE" "DRAFT" "TO" expression "SUBJECT" expression "BODY" expression
                    | "SEND" ( ( "TO" | "SUBJECT" | "BODY" | "CC" | "BCC" | "HEADER" | "ATTACH" ) expression | "REPLY" "TO" expression )*

browser-statement ::= "BROWSER" "OPEN" expression set-var?
                    | "BROWSER" expression browser-op set-var?

browser-op        ::= ( "NAVIGATE" | "HOVER" | "CLEAR" | "READ" | "EVALUATE" | "AUTH" | "MOBILE" | "SCREENSHOT" | "PDF" | "INTERCEPT" ) expression
                    | "CLOSE" | "BACK" | "FORWARD" | "RELOAD" | "COOKIES" | "VIEW"
                    | "CLICK" ( "AT" "X" expression "Y" expression | expression )
                    | ( "TYPE" | "SELECT" | "UPLOAD" ) expression "WITH" expression
                    | "SCROLL" "X" expression "Y" expression
                    | "EXTRACT" expression "AS" expression
                    | "WAIT" ( "FOR" ( "NETWORK" expression | expression ( "TO" expression )? ) | expression )
                    | "TAB" ( "NEXT" | "PREV" ) | "FOCUS" "CHECK" "AS" expression
                    | "STORAGE" ( "WRITE" expression "WITH" expression | "READ" expression )
                    | "COOKIE" "WRITE" expression "WITH" expression
                    | "VIEWPORT" "WIDTH" expression "HEIGHT" expression
                    | "DOWNLOAD" expression "TO" expression | "NETWORK" "LOG"
                    | "STREAM" "TO" expression

sync-statement    ::= "SYNC" "CHANNEL" expression ( "SEND" expression | "RECEIVE" | "CLOSE" )
                      set-var?

/* ======================================================================
   Verbs with the general shape. Each verb is its words followed by its
   parts in ANY order: the operand, its modifiers, a SET capture (only if
   it returns a value) and an OPEN ... CLOSE block (only if it takes one).
   Each modifier may appear once unless marked repeatable. Words written
   one after another inside quotes, like "WITH" "DOMAIN", are one modifier.
   ====================================================================== */

/* EMIT <operand>
   operand required (value)
   returns nothing (no SET capture) */
verb-emit         ::= "EMIT" verb-emit-part*
verb-emit-part    ::= expression

/* SLEEP <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     a unit - MILLISECONDS, SECONDS, MINUTES, or HOURS  (also written: MILLISECOND, SECONDS, SECOND, MINUTES, MINUTE, HOURS, HOUR) [required]
   returns nothing (no SET capture) */
verb-sleep        ::= "SLEEP" verb-sleep-part*
verb-sleep-part   ::= expression
                    | ( "MILLISECONDS" | "MILLISECOND" | "SECONDS" | "SECOND" | "MINUTES" | "MINUTE" | "HOURS" | "HOUR" )

/* STRING <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-string       ::= "STRING" verb-string-part*
verb-string-part  ::= expression | capture

/* NUMBER <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-number       ::= "NUMBER" verb-number-part*
verb-number-part  ::= expression | capture

/* SET <operand>
   operand required (target)
   modifiers, in any order, each once unless repeatable:
     AS <value> [required]
   returns nothing (no SET capture) */
verb-set          ::= "SET" verb-set-part*
verb-set-part     ::= target | "AS" expression

/* VARIABLE <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-variable     ::= "VARIABLE" verb-variable-part*
verb-variable-part ::= expression | capture

/* UNSET <operand>
   operand required (target)
   returns nothing (no SET capture) */
verb-unset        ::= "UNSET" verb-unset-part*
verb-unset-part   ::= target

/* UNSET PERSISTENT <operand>
   operand required (target)
   returns nothing (no SET capture) */
verb-unset-persistent ::= "UNSET" "PERSISTENT" verb-unset-persistent-part*
verb-unset-persistent-part ::= target

/* COLLAPSE <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-collapse     ::= "COLLAPSE" verb-collapse-part*
verb-collapse-part ::= expression | capture

/* CALCULATE <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-calculate    ::= "CALCULATE" verb-calculate-part*
verb-calculate-part ::= expression | capture

/* IF <operand>
   operand required (cond)
   returns nothing (no SET capture)
   takes an OPEN ... CLOSE block (required) */
verb-if           ::= "IF" verb-if-part*
verb-if-part      ::= condition | block-part

/* WHILE <operand>
   operand required (cond)
   returns nothing (no SET capture)
   takes an OPEN ... CLOSE block (required) */
verb-while        ::= "WHILE" verb-while-part*
verb-while-part   ::= condition | block-part

/* LOOP <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     TO <number> [required]
     STEP <number>
   SET ?var names the loop variable [required]
   takes an OPEN ... CLOSE block (required) */
verb-loop         ::= "LOOP" verb-loop-part*
verb-loop-part    ::= expression | "TO" expression | "STEP" expression | "SET" VARIABLE
                    | block-part

/* BREAK
   returns nothing (no SET capture) */
verb-break        ::= "BREAK"

/* CONTINUE
   returns nothing (no SET capture) */
verb-continue     ::= "CONTINUE"

/* EXIT <operand>
   operand optional (value)
   returns nothing (no SET capture) */
verb-exit         ::= "EXIT" verb-exit-part*
verb-exit-part    ::= expression

/* RETURN <operand>
   operand optional (value)
   returns nothing (no SET capture) */
verb-return       ::= "RETURN" verb-return-part*
verb-return-part  ::= expression

/* NEW ARRAY <operand>
   operand optional (value)
   returns a value: capture it with SET ?var */
verb-new-array    ::= "NEW" "ARRAY" verb-new-array-part*
verb-new-array-part ::= expression | capture

/* NEW MULTIARRAY <operand>
   operand optional (value)
   returns a value: capture it with SET ?var */
verb-new-multiarray ::= "NEW" "MULTIARRAY" verb-new-multiarray-part*
verb-new-multiarray-part ::= expression | capture

/* NEW OBJECT <operand>
   operand optional (value)
   returns a value: capture it with SET ?var */
verb-new-object   ::= "NEW" "OBJECT" verb-new-object-part*
verb-new-object-part ::= expression | capture

/* APPEND <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     AS <value>
     TO <array or object> [required]
   returns a value: capture it with SET ?var */
verb-append       ::= "APPEND" verb-append-part*
verb-append-part  ::= expression | "AS" expression | "TO" expression | capture

/* COUNT <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-count        ::= "COUNT" verb-count-part*
verb-count-part   ::= expression | capture

/* KEYS <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-keys         ::= "KEYS" verb-keys-part*
verb-keys-part    ::= expression | capture

/* VALUES <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-values       ::= "VALUES" verb-values-part*
verb-values-part  ::= expression | capture

/* REMOVE KEY <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     FROM <object> [required]
   returns a value: capture it with SET ?var */
verb-remove-key   ::= "REMOVE" "KEY" verb-remove-key-part*
verb-remove-key-part ::= expression | "FROM" expression | capture

/* REVERSE ARRAY <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-reverse-array ::= "REVERSE" "ARRAY" verb-reverse-array-part*
verb-reverse-array-part ::= expression | capture

/* DEDUPLICATE <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-deduplicate  ::= "DEDUPLICATE" verb-deduplicate-part*
verb-deduplicate-part ::= expression | capture

/* FLATTEN <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-flatten      ::= "FLATTEN" verb-flatten-part*
verb-flatten-part ::= expression | capture

/* SEARCH ARRAY <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     FOR <value> [required]
   returns a value: capture it with SET ?var */
verb-search-array ::= "SEARCH" "ARRAY" verb-search-array-part*
verb-search-array-part ::= expression | "FOR" expression | capture

/* SEARCH OBJECT <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     FOR <value> [required]
   returns a value: capture it with SET ?var */
verb-search-object ::= "SEARCH" "OBJECT" verb-search-object-part*
verb-search-object-part ::= expression | "FOR" expression | capture

/* JOIN <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     WITH <separator>  (also written: BY)
   returns a value: capture it with SET ?var */
verb-join         ::= "JOIN" verb-join-part*
verb-join-part    ::= expression | ( "WITH" | "BY" ) expression | capture

/* JOIN ARRAY <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     WITH <separator>  (also written: BY)
   returns a value: capture it with SET ?var */
verb-join-array   ::= "JOIN" "ARRAY" verb-join-array-part*
verb-join-array-part ::= expression | ( "WITH" | "BY" ) expression | capture

/* SLICE <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     FROM <index> [required]
     TO <index>
   returns a value: capture it with SET ?var */
verb-slice        ::= "SLICE" verb-slice-part*
verb-slice-part   ::= expression | "FROM" expression | "TO" expression | capture

/* SORT <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     ASCENDING  (also written: ASC)
     DESCENDING  (also written: DESC)
     BY <key>
   returns a value: capture it with SET ?var */
verb-sort         ::= "SORT" verb-sort-part*
verb-sort-part    ::= expression | ( "ASCENDING" | "ASC" ) | ( "DESCENDING" | "DESC" )
                    | "BY" expression | capture

/* MERGE ARRAY <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     WITH <array> [required]
   returns a value: capture it with SET ?var */
verb-merge-array  ::= "MERGE" "ARRAY" verb-merge-array-part*
verb-merge-array-part ::= expression | "WITH" expression | capture

/* MERGE OBJECT <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     WITH <object> [required]
   returns a value: capture it with SET ?var */
verb-merge-object ::= "MERGE" "OBJECT" verb-merge-object-part*
verb-merge-object-part ::= expression | "WITH" expression | capture

/* LENGTH <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-length       ::= "LENGTH" verb-length-part*
verb-length-part  ::= expression | capture

/* STRING UPPERCASE <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-string-uppercase ::= "STRING" "UPPERCASE" verb-string-uppercase-part*
verb-string-uppercase-part ::= expression | capture

/* STRING LOWERCASE <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-string-lowercase ::= "STRING" "LOWERCASE" verb-string-lowercase-part*
verb-string-lowercase-part ::= expression | capture

/* TRIM STRING <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-trim-string  ::= "TRIM" "STRING" verb-trim-string-part*
verb-trim-string-part ::= expression | capture

/* REVERSE STRING <operand>
   operand required (value)
   returns a value: capture it with SET ?var */
verb-reverse-string ::= "REVERSE" "STRING" verb-reverse-string-part*
verb-reverse-string-part ::= expression | capture

/* SPLIT <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     BY <separator>  (also written: WITH) [required]
   returns a value: capture it with SET ?var */
verb-split        ::= "SPLIT" verb-split-part*
verb-split-part   ::= expression | ( "BY" | "WITH" ) expression | capture

/* SEARCH STRING <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     FOR <needle> [required]
   returns a value: capture it with SET ?var */
verb-search-string ::= "SEARCH" "STRING" verb-search-string-part*
verb-search-string-part ::= expression | "FOR" expression | capture

/* SELECT STRING <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     FROM <index> [required]
     TO <index>
   returns a value: capture it with SET ?var */
verb-select-string ::= "SELECT" "STRING" verb-select-string-part*
verb-select-string-part ::= expression | "FROM" expression | "TO" expression | capture

/* REPLACE STRING <operand>
   operand optional (value)
   modifiers, in any order, each once unless repeatable:
     ALL <needle>
     ONCE <needle>
     FROM <index>
     TO <index>
     WITH <replacement> [required]
     WHERE <subject> [required]
   returns a value: capture it with SET ?var */
verb-replace-string ::= "REPLACE" "STRING" verb-replace-string-part*
verb-replace-string-part ::= expression | "ALL" expression | "ONCE" expression
                           | "FROM" expression | "TO" expression | "WITH" expression
                           | "WHERE" expression | capture

/* FILE WRITE <operand>
   operand required (value)
   modifiers, in any order, each once unless repeatable:
     CONTENT <text>  (also written: WITH, AS)
     TO <path>
     BASE64
